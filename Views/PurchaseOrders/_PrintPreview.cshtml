@model PurchaseOrderViewModel
@{
    string statusBadgeClass = Model.Status switch
    {
        "Pending" => "bg-warning",
        "Approved" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
<div class="print-preview-wrapper">
    <div class="print-preview-header">
        <div>
            <h1 class="print-shop-name">KAIJENSON MOTOR SHOP</h1>
            <p class="print-po-title">Purchase Order</p>
        </div>
        <div class="print-header-info">
            <div class="print-po-number">PO #: @Model.PurchaseOrderNumber</div>
            <div class="print-po-date">Date: @Model.OrderDate.ToString("MMM dd, yyyy")</div>
            @if (Model.ExpectedDeliveryDate.HasValue)
            {
                <div class="print-po-delivery">Expected Delivery: @Model.ExpectedDeliveryDate.Value.ToString("MMM dd, yyyy")</div>
            }
            <div class="print-po-status">Status: <span class="badge @statusBadgeClass">@Model.Status</span></div>
        </div>
    </div>

    <hr class="print-separator" />

    <div class="print-supplier-section">
        <h5 class="fw-bold">Supplier Information</h5>
        <table class="table table-sm table-borderless print-supplier-table">
            <tr><td class="fw-semibold" style="width:120px;">Company:</td><td>@Model.SupplierName</td></tr>
            <tr><td class="fw-semibold">Contact:</td><td>@(Model.ContactPerson ?? "N/A")</td></tr>
            <tr><td class="fw-semibold">Phone:</td><td>@(Model.ContactNumber ?? "N/A")</td></tr>
            <tr><td class="fw-semibold">Address:</td><td>@(Model.SupplierAddress ?? "N/A")</td></tr>
        </table>
    </div>

    <hr class="print-separator" />

    <div class="print-items-section">
        <table class="table table-bordered print-items-table">
            <thead>
                <tr class="print-table-header">
                    <th class="text-center">#</th>
                    <th>Product</th>
                    <th>Brand</th>
                    <th class="text-end">Price</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">@idx</td>
                        <td>@item.ProductName</td>
                        <td>@(item.Brand ?? "")</td>
                        <td class="text-end">@item.Price.ToString("N2")</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end fw-semibold">@item.Subtotal.ToString("N2")</td>
                    </tr>
                    idx++;
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center py-3 text-muted">No items.</td></tr>
                }
            </tbody>
            <tfoot>
                <tr class="print-total-row">
                    <td colspan="5" class="text-end fw-bold fs-5">Total Amount:</td>
                    <td class="text-end fw-bold fs-5">@Model.TotalAmount.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="print-remarks-section">
            <h5 class="fw-bold">Remarks:</h5>
            <p class="mb-0">@Model.Remarks</p>
        </div>
    }

    <hr class="print-separator" />

    <div class="print-signatures">
        <div class="row">
            <div class="col-5">
                <p class="fw-bold mb-5">Prepared By:</p>
                <p class="mb-0">@(Model.CreatedByName ?? "________________________")</p>
                <hr class="m-0" />
            </div>
            <div class="col-2"></div>
            <div class="col-5">
                <p class="fw-bold mb-5">Approved By:</p>
                <p class="mb-0">________________________</p>
                <hr class="m-0" />
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/print.css" />
