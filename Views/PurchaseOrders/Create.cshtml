@model PurchaseOrderViewModel
@{ ViewData["Title"] = "Create Purchase Order"; }

<div class="page-header">
    <div>
        <h1>Create Purchase Order</h1>
        <p>Create a new purchase order.</p>
    </div>
</div>

<div class="card form-card form-card-wide">
    <div class="card-body">
        <form asp-action="Create" id="poForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
<label asp-for="SupplierId" class="form-label"></label>
                    @if (Model.IsReorder)
                    {
                        <select asp-for="SupplierId" class="form-select" asp-items="Model.Suppliers" id="supplierSelect" disabled>
                            <option value="">-- Select Supplier --</option>
                        </select>
                        <input type="hidden" asp-for="SupplierId" />
                    }
                    else
                    {
                        <select asp-for="SupplierId" class="form-select" asp-items="Model.Suppliers" id="supplierSelect">
                            <option value="">-- Select Supplier --</option>
                        </select>
                    }
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    <div id="supplierInfo" class="mt-2 small text-muted d-none">
                        <div id="supplierContact"></div>
                        <div id="supplierPhone"></div>
                        <div id="supplierAddress"></div>
                    </div>
</div>
                 <div class="col-md-6">
                     <label asp-for="OrderDate" class="form-label"></label>
                     <input asp-for="OrderDate" class="form-control" type="date" />
                     <span asp-validation-for="OrderDate" class="text-danger small"></span>
                 </div>
                 </div>

        @if (Model.IsReorder && Model.Items?.Any() == true)
        {
            var item = Model.Items[0];
            <div class="reorder-details mb-3">
                <h5>Reorder Details</h5>
                <div class="row g-2">
                    <div class="col-md-4"><strong>Product:</strong> @item.ProductName</div>
                    <div class="col-md-4"><strong>Brand:</strong> @item.Brand</div>
                    <div class="col-md-4"><strong>Category:</strong> @item.Category</div>
                    <div class="col-md-4"><strong>Current Stock:</strong> @item.CurrentStock</div>
                    <div class="col-md-4"><strong>Reorder Level:</strong> @item.ReorderLevel</div>
                </div>
            </div>
        }


            <div class="mb-3">
                <label class="form-label">Products</label>
                <span asp-validation-for="Items" class="text-danger small d-block"></span>
                <div class="table-container">
                    <table class="table mb-0" id="itemsTable">
                        <thead>
<tr>
                                 <th style="width:75%;">Product</th>
                                 <th style="width:20%;">Quantity</th>
                                 <th style="width:40px;"></th>
                             </tr>
                        </thead>
                        <tbody id="itemsContainer">
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="addItemBtn" @(Model.IsReorder ? "style=\"display:none;\"" : "")>
                    <i class="bi bi-plus-lg"></i> Add Product
                </button>
            </div>

            <div class="mb-3">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Remarks" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    Create Purchase Order
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var products = [];
        var existingItems = @Html.Raw(Json.Serialize(Model.Items));
        var itemIndex = 0;

        function buildProductOptions(data) {
            var options = '<option value="">-- Select Product --</option>';
            products.forEach(function (p) {
                var selected = (data && data.productId == p.productId) ? 'selected' : '';
                options += '<option value="' + p.productId + '" data-brand="' + (p.brand || '') + '" data-category="' + (p.category || '') + '" ' + selected + '>' + p.productName + '</option>';
            });
            return options;
        }

        function refreshAllProductOptions() {
            document.querySelectorAll('.product-select').forEach(function (sel) {
                var currentVal = sel.value;
                sel.innerHTML = buildProductOptions({ productId: currentVal ? parseInt(currentVal) : 0 });
            });
        }

        function loadProducts(supplierId) {
            if (!supplierId) {
                products = [];
                refreshAllProductOptions();
                return;
            }
            fetch('/PurchaseOrders/GetProductsBySupplier/' + supplierId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    products = data;
                    refreshAllProductOptions();
                })
                .catch(function () {
                    products = [];
                    refreshAllProductOptions();
                });
        }

        function reindexRows() {
            document.querySelectorAll('#itemsContainer tr').forEach(function (row, index) {
                row.querySelectorAll('input, select').forEach(function (field) {
                    if (field.name) {
                        field.name = field.name.replace(/Items\[\d+\]/, 'Items[' + index + ']');
                    }
                });
            });
            itemIndex = document.querySelectorAll('#itemsContainer tr').length;
        }

        function addItemRow(data) {
            var container = document.getElementById('itemsContainer');
            var row = document.createElement('tr');

            var options = buildProductOptions(data);

            row.innerHTML =
                '<td><select name="Items[' + itemIndex + '].ProductId" class="form-select form-select-sm product-select">' + options + '</select></td>' +
                '<td><input type="number" name="Items[' + itemIndex + '].Quantity" class="form-control form-control-sm item-qty" value="' + (data && data.quantity ? data.quantity : 1) + '" min="1" required /></td>' +
                '<td><button type="button" class="btn btn-icon btn-icon-delete remove-item" style="width:28px;height:28px;font-size:11px;"><i class="bi bi-x"></i></button></td>';

            container.appendChild(row);
            itemIndex++;

            // No brand/category handling needed

            row.querySelector('.remove-item').addEventListener('click', function () {
                if (!confirm('Remove this product from the order?')) return;
                row.remove();
                reindexRows();
            });
        }

        function updateSupplierInfo() {
            var supplierId = document.getElementById('supplierSelect').value;
            var infoDiv = document.getElementById('supplierInfo');
            if (!supplierId) {
                infoDiv.classList.add('d-none');
                loadProducts(0);
                return;
            }
            loadProducts(supplierId);
            fetch('/PurchaseOrders/GetSupplierInfo/' + supplierId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    document.getElementById('supplierContact').textContent = 'Contact: ' + (data.contactPerson || 'N/A');
                    document.getElementById('supplierPhone').textContent = 'Phone: ' + (data.contactNumber || 'N/A');
                    document.getElementById('supplierAddress').textContent = 'Address: ' + (data.address || 'N/A');
                    infoDiv.classList.remove('d-none');
                })
                .catch(function () { infoDiv.classList.add('d-none'); });
        }

        document.getElementById('supplierSelect').addEventListener('change', updateSupplierInfo);
        document.getElementById('addItemBtn').addEventListener('click', function () { addItemRow(); });

        // Restore previously submitted rows after a validation error, otherwise start with one empty row
        if (existingItems && existingItems.length > 0) {
            var supplierId = document.getElementById('supplierSelect').value;
            if (supplierId) {
                fetch('/PurchaseOrders/GetProductsBySupplier/' + supplierId)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        products = data;
                        existingItems.forEach(function (item) { addItemRow(item); });
                    })
                    .catch(function () { existingItems.forEach(function (item) { addItemRow(item); }); });
            } else {
                existingItems.forEach(function (item) { addItemRow(item); });
            }
        } else {
addItemRow();

            // Reorder mode adjustments
            var isReorder = @Model.IsReorder.ToString().ToLower();
            if (isReorder) {
                var firstProdSelect = document.querySelector('.product-select');
                if (firstProdSelect) {
                    firstProdSelect.setAttribute('disabled', 'disabled');
                    var hiddenProd = document.createElement('input');
                    hiddenProd.type = 'hidden';
                    hiddenProd.name = 'Items[0].ProductId';
                    hiddenProd.value = firstProdSelect.value;
                    document.getElementById('poForm').appendChild(hiddenProd);
                }
            }
        }

        // Form validation
        document.getElementById('poForm').addEventListener('submit', function (e) {
            var supplierId = document.getElementById('supplierSelect').value;
            if (!supplierId) {
                e.preventDefault();
                alert('Please select a supplier.');
                return;
            }
            var hasProduct = false;
            document.querySelectorAll('.product-select').forEach(function (sel) {
                if (sel.value) hasProduct = true;
            });
            if (!hasProduct) {
                e.preventDefault();
                alert('Please add at least one product.');
                return;
            }

            reindexRows();
        });
    </script>
}
