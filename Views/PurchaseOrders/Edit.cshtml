@model PurchaseOrderViewModel
@{ ViewData["Title"] = "Edit Purchase Order"; }

<div class="page-header">
    <div>
        <h1>Edit Purchase Order</h1>
        <p>@Model.PurchaseOrderNumber</p>
    </div>
</div>

<div class="card form-card form-card-wide">
    <div class="card-body">
        <form asp-action="Edit" id="poForm">
            <input type="hidden" asp-for="PurchaseOrderId" />
            <input type="hidden" asp-for="PurchaseOrderNumber" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label">PO Number</label>
                    <input class="form-control" value="@Model.PurchaseOrderNumber" readonly />
                </div>
                <div class="col-md-3">
                    <label asp-for="SupplierId" class="form-label"></label>
                    <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers" id="supplierSelect">
                        <option value="">-- Select Supplier --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    <div id="supplierInfo" class="mt-2 small text-muted d-none">
                        <div id="supplierContact"></div>
                        <div id="supplierPhone"></div>
                        <div id="supplierAddress"></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="OrderDate" class="form-label"></label>
                    <input asp-for="OrderDate" class="form-control" type="date" />
                    <span asp-validation-for="OrderDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ExpectedDeliveryDate" class="form-label"></label>
                    <input asp-for="ExpectedDeliveryDate" class="form-control" type="date" />
                    <span asp-validation-for="ExpectedDeliveryDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Products</label>
                <span asp-validation-for="Items" class="text-danger small d-block"></span>
                <div class="table-container">
                    <table class="table mb-0" id="itemsTable">
                        <thead>
                            <tr>
                                <th style="width:28%;">Product</th>
                                <th style="width:12%;">Brand</th>
                                <th style="width:10%;">Stock</th>
                                <th style="width:12%;">Price</th>
                                <th style="width:12%;">Quantity</th>
                                <th style="width:12%;">Subtotal</th>
                                <th style="width:40px;"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsContainer">
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end fw-bold">Grand Total:</td>
                                <td class="fw-bold fs-5" id="grandTotal">0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="addItemBtn">
                    <i class="bi bi-plus-lg"></i> Add Product
                </button>
            </div>

            <div class="mb-3">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Remarks" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-check-lg"></i> Update Purchase Order
                </button>
                <a asp-action="Details" asp-route-id="@Model.PurchaseOrderId" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var products = [];
        var existingItems = @Html.Raw(Json.Serialize(Model.Items));
        var itemIndex = 0;

        function buildProductOptions(data) {
            var options = '<option value="">-- Select Product --</option>';
            products.forEach(function (p) {
                var selected = (data && data.productId == p.productId) ? 'selected' : '';
                options += '<option value="' + p.productId + '" data-brand="' + (p.brand || '') + '" data-stock="' + p.quantityOnHand + '" data-price="' + p.price + '" ' + selected + '>' + p.productName + '</option>';
            });
            return options;
        }

        function refreshAllProductOptions() {
            document.querySelectorAll('.product-select').forEach(function (sel) {
                var currentVal = sel.value;
                sel.innerHTML = buildProductOptions({ productId: currentVal ? parseInt(currentVal) : 0 });
            });
        }

        function loadProducts(supplierId) {
            if (!supplierId) {
                products = [];
                refreshAllProductOptions();
                return;
            }
            fetch('/PurchaseOrders/GetProductsBySupplier/' + supplierId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    products = data;
                    refreshAllProductOptions();
                })
                .catch(function () {
                    products = [];
                    refreshAllProductOptions();
                });
        }

        function addItemRow(data) {
            var container = document.getElementById('itemsContainer');
            var row = document.createElement('tr');

            var options = buildProductOptions(data);

            row.innerHTML =
                '<td><select name="Items[' + itemIndex + '].ProductId" class="form-select form-select-sm product-select">' + options + '</select></td>' +
                '<td class="brand-display align-middle">' + (data ? (data.brand || '') : '') + '</td>' +
                '<td class="current-stock align-middle text-center">' + (data ? data.currentStock : 0) + '</td>' +
                '<td class="price-display align-middle text-end fw-semibold text-nowrap">' + (data ? parseFloat(data.price).toFixed(2) : '0.00') + '</td>' +
                '<td><input type="number" name="Items[' + itemIndex + '].Quantity" class="form-control form-control-sm item-qty" value="' + (data ? data.quantity : 1) + '" min="1" /></td>' +
                '<td class="item-subtotal align-middle text-end fw-semibold">' + (data ? (data.quantity * data.price).toFixed(2) : '0.00') + '</td>' +
                '<td><button type="button" class="btn btn-icon btn-icon-delete remove-item" style="width:28px;height:28px;font-size:11px;"><i class="bi bi-x"></i></button></td>';

            container.appendChild(row);
            itemIndex++;

            var select = row.querySelector('.product-select');
            select.addEventListener('change', function () {
                var selectedOption = select.options[select.selectedIndex];
                row.querySelector('.brand-display').textContent = selectedOption ? selectedOption.getAttribute('data-brand') || '' : '';
                row.querySelector('.current-stock').textContent = selectedOption ? selectedOption.getAttribute('data-stock') || 0 : 0;
                row.querySelector('.price-display').textContent = selectedOption ? parseFloat(selectedOption.getAttribute('data-price') || 0).toFixed(2) : '0.00';
                updateRowSubtotal(row);
                updateGrandTotal();
            });

            var qty = row.querySelector('.item-qty');
            qty.addEventListener('input', function () { updateRowSubtotal(row); updateGrandTotal(); });

            row.querySelector('.remove-item').addEventListener('click', function () {
                if (!confirm('Remove this product from the order?')) return;
                row.remove();
                updateGrandTotal();
            });

            if (data && data.productId) {
                var selectedOption = select.options[select.selectedIndex];
                row.querySelector('.brand-display').textContent = selectedOption ? selectedOption.getAttribute('data-brand') || '' : '';
                row.querySelector('.current-stock').textContent = selectedOption ? selectedOption.getAttribute('data-stock') || 0 : 0;
                row.querySelector('.price-display').textContent = selectedOption ? parseFloat(selectedOption.getAttribute('data-price') || 0).toFixed(2) : '0.00';
                updateRowSubtotal(row);
            }

            updateGrandTotal();
        }

        function updateRowSubtotal(row) {
            var qty = parseInt(row.querySelector('.item-qty').value) || 0;
            var price = parseFloat(row.querySelector('.price-display').textContent) || 0;
            row.querySelector('.item-subtotal').textContent = (qty * price).toFixed(2);
        }

        function updateGrandTotal() {
            var total = 0;
            document.querySelectorAll('.item-subtotal').forEach(function (el) {
                total += parseFloat(el.textContent) || 0;
            });
            document.getElementById('grandTotal').textContent = total.toFixed(2);
        }

        function updateSupplierInfo() {
            var supplierId = document.getElementById('supplierSelect').value;
            var infoDiv = document.getElementById('supplierInfo');
            if (!supplierId) {
                infoDiv.classList.add('d-none');
                loadProducts(0);
                return;
            }
            loadProducts(supplierId);
            fetch('/PurchaseOrders/GetSupplierInfo/' + supplierId)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    document.getElementById('supplierContact').textContent = 'Contact: ' + (data.contactPerson || 'N/A');
                    document.getElementById('supplierPhone').textContent = 'Phone: ' + (data.contactNumber || 'N/A');
                    document.getElementById('supplierAddress').textContent = 'Address: ' + (data.address || 'N/A');
                    infoDiv.classList.remove('d-none');
                })
                .catch(function () { infoDiv.classList.add('d-none'); });
        }

        document.getElementById('supplierSelect').addEventListener('change', updateSupplierInfo);
        document.getElementById('addItemBtn').addEventListener('click', function () { addItemRow(); });

        // Load existing items
        if (existingItems && existingItems.length > 0) {
            // Load products for the current supplier first, then populate rows
            var supplierId = document.getElementById('supplierSelect').value;
            if (supplierId) {
                fetch('/PurchaseOrders/GetProductsBySupplier/' + supplierId)
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        products = data;
                        existingItems.forEach(function (item) { addItemRow(item); });
                    })
                    .catch(function () {
                        existingItems.forEach(function (item) { addItemRow(item); });
                    });
            } else {
                existingItems.forEach(function (item) { addItemRow(item); });
            }
        } else {
            addItemRow();
        }

        // Load supplier info on page load
        if (document.getElementById('supplierSelect').value) {
            updateSupplierInfo();
        }

        function reindexRows() {
            var rows = document.querySelectorAll('#itemsContainer tr');
            rows.forEach(function (row, index) {
                row.querySelectorAll('[name^="Items["]').forEach(function (el) {
                    var name = el.getAttribute('name');
                    el.setAttribute('name', name.replace(/Items\[\d+\]/, 'Items[' + index + ']'));
                });
            });
        }

        document.getElementById('poForm').addEventListener('submit', function (e) {
            reindexRows();
            var hasProduct = false;
            document.querySelectorAll('.product-select').forEach(function (sel) {
                if (sel.value) hasProduct = true;
            });
            if (!hasProduct) {
                e.preventDefault();
                alert('Please add at least one product.');
            }
        });
    </script>
}
