@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }

<div class="page-header">
    <div>
        <h1>Products</h1>
        <p>Manage inventory.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Product</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label class="form-label">Search</label>
                <input type="text" name="searchString" class="form-control" placeholder="Name, brand, or part number..." value="@ViewData["CurrentFilter"]" style="min-width:200px;" />
            </div>
            <div>
                <label class="form-label">Category</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories" style="min-width:160px;">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:50px;">Image</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>Part #</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="action-cell">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:6px;" onerror="this.src='/uploads/products/placeholder.svg'" />
                                }
                                else
                                {
                                    <img src="/uploads/products/placeholder.svg" alt="" style="width:40px;height:40px;object-fit:cover;border-radius:6px;" />
                                }
                            </td>
                            <td>@item.ProductId</td>
                            <td><span class="fw-medium">@item.ProductName</span></td>
                            <td>@(item.Brand ?? "-")</td>
                            <td><span class="small">@(item.PartNumber ?? "-")</span></td>
                            <td>@item.Category?.CategoryName</td>
                            <td class="fw-semibold">@item.Price.ToString("N2")</td>
                            <td>@item.QuantityOnHand</td>
                            <td>
                                @if (item.StockStatus == "Out of Stock") { <span class="badge bg-danger">Out of Stock</span> }
                                else if (item.StockStatus == "Low Stock") { <span class="badge bg-warning text-dark">Low Stock</span> }
                                else { <span class="badge bg-success">Available</span> }
                            </td>
                            <td class="action-cell">
                                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-icon btn-icon-view" title="View Product Details" aria-label="View @item.ProductName"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-icon btn-icon-edit" title="Edit Product" aria-label="Edit @item.ProductName"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" style="display:inline" onsubmit="return confirm('Delete product &quot;@item.ProductName&quot;?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-icon btn-icon-delete" title="Delete Product" aria-label="Delete @item.ProductName"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center py-4 text-muted">No products found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
