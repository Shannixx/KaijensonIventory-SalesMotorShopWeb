@{
    ViewData["Title"] = "Reset Manager Password";
    int staffId = (int)(ViewData["TargetStaffId"] ?? 0);
    string staffName = ViewData["TargetStaffName"] as string ?? "";
}
<div class="page-header"><div><h1>Reset Password</h1><p>Reset password for @staffName.</p></div></div>
<div class="card form-card"><div class="card-body">
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" name="id" value="@staffId" />
        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label for="TemporaryPassword" class="form-label">Temporary Password</label>
                <input type="password" name="TemporaryPassword" id="TemporaryPassword" class="form-control" />
                @Html.ValidationMessage("TemporaryPassword", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6">
                <label for="ConfirmTemporaryPassword" class="form-label">Confirm Temporary Password</label>
                <input type="password" name="ConfirmTemporaryPassword" id="ConfirmTemporaryPassword" class="form-control" />
                @Html.ValidationMessage("ConfirmTemporaryPassword", new { @class = "text-danger small" })
            </div>
        </div>
        <div class="form-actions mt-3">
            <button type="submit" class="btn btn-app-primary">
                <i class="bi bi-key" aria-hidden="true"></i>
                <span>Reset Password</span>
            </button>
            <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
        </div>
    </form>
</div></div>
