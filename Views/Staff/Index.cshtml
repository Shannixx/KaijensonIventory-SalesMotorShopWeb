@model IEnumerable<Staff>
@{ ViewData["Title"] = "Staff"; }
<div class="page-header">
    <div><h1>Staff</h1><p>Manage staff accounts.</p></div>
    <!-- Create Staff button removed as per requirements -->
</div>
@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Staff",
        QueryValue = ViewData["CurrentFilter"] as string,
        Placeholder = "Search by name or username...",
        AriaLabel = "Search staff",
        InputId = "searchStaff",
        ClearActionName = "Index",
        ClearControllerName = "Staff"
    };
}
<partial name="_SearchToolbar" model="searchModel" />
<div class="card"><div class="card-body p-0"><div class="table-container"><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Username</th><th>Contact</th><th>Role</th><th>Status</th><th class="actions-column actions-column-wide">Actions</th></tr></thead><tbody>
@foreach (var item in Model) {
    bool isYou = (ViewData["CurrentStaffId"] as int?) == item.StaffId;
    <tr class="@(isYou ? "table-warning" : "")">
        <td>@item.StaffId</td>
        <td>
            @item.StaffName
            @if (isYou)
            {
                <span class="badge bg-warning text-dark">You</span>
            }
        </td>
        <td>@item.UserName</td>
        <td>@item.ContactNumber</td>
        <td><span class="badge @(item.Role == "Admin" ? "bg-primary" : "bg-secondary")">@item.Role</span></td>
        <td><span class="badge @(item.Status == "Active" ? "bg-success" : "bg-secondary")">@item.Status</span></td>
        <td class="action-cell action-cell-wide">
            <div class="action-buttons">
                <a asp-action="Details" asp-route-id="@item.StaffId" class="btn btn-icon btn-icon-view" title="View Staff Details" aria-label="View @item.StaffName"><i class="bi bi-eye"></i></a>
                @if (!isYou)
                {
                <form asp-action="ToggleStatus" asp-route-id="@item.StaffId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-icon" title="@(item.Status == "Active" ? "Deactivate" : "Activate") staff" aria-label="@(item.Status == "Active" ? "Deactivate" : "Activate") @item.StaffName"><i class="bi @(item.Status == "Active" ? "bi-person-slash" : "bi-person-check")"></i></button>
                </form>
                }
            </div>
        </td>
    </tr>
}
@if (!Model.Any()) { <tr><td colspan="7" class="text-center py-4 text-muted">No staff found.</td></tr> }
</tbody></table></div></div></div>
<partial name="_Pagination" />
