@model IEnumerable<Staff>
@{ ViewData["Title"] = "Staff"; }
<div class="page-header">
    <div><h1>Staff</h1><p>Manage staff accounts.</p></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create Staff</a>
</div>
@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Staff",
        QueryValue = ViewData["CurrentFilter"] as string,
        Placeholder = "Search by name or username...",
        AriaLabel = "Search staff",
        InputId = "searchStaff",
        ClearActionName = "Index",
        ClearControllerName = "Staff"
    };
}
<partial name="_SearchToolbar" model="searchModel" />
<div class="card"><div class="card-body p-0"><div class="table-container"><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Username</th><th>Contact</th><th>Role</th><th class="actions-column actions-column-wide">Actions</th></tr></thead><tbody>
@foreach (var item in Model) {
    bool isYou = (ViewData["CurrentStaffId"] as int?) == item.StaffId;
    <tr class="@(isYou ? "table-warning" : "")">
        <td>@item.StaffId</td>
        <td>
            @item.StaffName
            @if (isYou)
            {
                <span class="badge bg-warning text-dark">You</span>
            }
        </td>
        <td>@item.UserName</td>
        <td>@item.ContactNumber</td>
        <td><span class="badge @(item.Role == "Admin" ? "bg-primary" : "bg-secondary")">@item.Role</span></td>
        <td class="action-cell action-cell-wide">
            <div class="action-buttons">
                <a asp-action="Details" asp-route-id="@item.StaffId" class="btn btn-icon btn-icon-view" title="View Staff Details" aria-label="View @item.StaffName"><i class="bi bi-eye"></i></a>
                <a asp-action="Edit" asp-route-id="@item.StaffId" class="btn btn-icon btn-icon-edit" title="Edit Staff" aria-label="Edit @item.StaffName"><i class="bi bi-pencil"></i></a>
                <a asp-action="ChangePassword" asp-route-id="@item.StaffId" class="btn btn-icon btn-icon-key" title="Change Password" aria-label="Change password for @item.StaffName"><i class="bi bi-key"></i></a>
                <form asp-action="Delete" asp-route-id="@item.StaffId" method="post" id="delete-staff-@item.StaffId" class="action-form">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-staff-@item.StaffId" data-delete-record-name="@item.StaffName" data-delete-entity-name="staff" title="Delete staff" aria-label="Delete staff @item.StaffName"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </td>
    </tr>
}
@if (!Model.Any()) { <tr><td colspan="6" class="text-center py-4 text-muted">No staff found.</td></tr> }
</tbody></table></div></div></div>
<partial name="_Pagination" />
