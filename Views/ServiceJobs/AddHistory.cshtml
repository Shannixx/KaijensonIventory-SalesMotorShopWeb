@model KaijensonIventory_SalesMotorShopWeb.Models.ServiceHistory
@{
    var job = ViewBag.ServiceJob as KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob;
    ViewData["Title"] = $"Add History — {job?.ServiceJobNumber}";
}
<div class="page-header">
    <div>
        <h1>Add History — @job?.ServiceJobNumber</h1>
        <p>@job?.Service?.ServiceName &middot; Mechanic: @job?.Mechanic?.MechanicName</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="AddHistory" asp-route-id="@job?.ServiceJobId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
            <input type="hidden" asp-for="ServiceJobId" />

            <div class="mb-3">
                <label asp-for="WorkDate" class="form-label"></label>
                <input asp-for="WorkDate" class="form-control" type="date" />
                <span asp-validation-for="WorkDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Work Performed</label>
                <input asp-for="Description" class="form-control" placeholder="e.g. Change Oil, Brake Adjustment" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AmountReceived" class="form-label"></label>
                <input asp-for="AmountReceived" class="form-control" type="number" step="0.01" min="0" value="0" />
                <span asp-validation-for="AmountReceived" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentStatus" class="form-label"></label>
                <select asp-for="PaymentStatus" class="form-select">
                    @foreach (var s in KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob.AllPaymentStatuses)
                    {
                        <option value="@s" selected="@(Model.PaymentStatus == s)">@s</option>
                    }
                </select>
                <span asp-validation-for="PaymentStatus" class="text-danger small"></span>
                <div class="form-text">Each entry is kept permanently. Previous history records are never modified.</div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-journal-plus" aria-hidden="true"></i>
                    <span>Add History Entry</span>
                </button>
                <a asp-action="Details" asp-route-id="@job?.ServiceJobId" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
