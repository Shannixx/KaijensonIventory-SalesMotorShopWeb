@model KaijensonIventory_SalesMotorShopWeb.ViewModels.ServiceJobFormViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Create Service Job";
    var services = ViewBag.ServicesList as List<KaijensonIventory_SalesMotorShopWeb.Models.Service> ?? new List<KaijensonIventory_SalesMotorShopWeb.Models.Service>();
    var mechanics = ViewBag.CreateMechanics as List<KaijensonIventory_SalesMotorShopWeb.Models.Mechanic> ?? new List<KaijensonIventory_SalesMotorShopWeb.Models.Mechanic>();
    var busyMechanicIds = ViewBag.BusyMechanicIds as HashSet<int> ?? new HashSet<int>();
    var ph = CultureInfo.GetCultureInfo("en-PH");
}
<div class="page-header">
    <div>
        <h1>Create Service Job</h1>
        <p>Record a new service job for a customer.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="ServiceId" class="form-label">Base Service</label>
                @if (services.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mb-2" role="group" aria-label="Quick service selection">
                        @foreach (var s in services)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary quick-service-btn" data-service-id="@s.ServiceId">@s.ServiceName</button>
                        }
                    </div>
                }
                <select asp-for="ServiceId" id="serviceSelect" class="form-select">
                    <option value="">-- Select Base Service --</option>
                    @foreach (var s in services)
                    {
                        <option value="@s.ServiceId" data-price-cents="@((s.ServicePrice * 100m).ToString("0", CultureInfo.InvariantCulture))" selected="@(Model.ServiceId == s.ServiceId)">
                            @s.ServiceName — ₱@s.ServicePrice.ToString("N2", ph)
                        </option>
                    }
                </select>
                <span asp-validation-for="ServiceId" class="text-danger small"></span>
                @if (!services.Any())
                {
                    <div class="form-text">No active base services are available. Add one under the Service tab first.</div>
                }
            </div>

            <!-- Service Price (read‑only) -->
            <div class="mb-3">
                <label for="servicePriceDisplay" class="form-label">Base Service Price</label>
                <input type="text" class="form-control" id="servicePriceDisplay" value="₱0.00" readonly />
                <div class="form-text">Prices are calculated from the selected base service when saved.</div>
            </div>

            <!-- Transaction summary (read‑only) -->
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="totalPriceDisplay" class="form-label">Total Service Price</label>
                    <input type="text" class="form-control" id="totalPriceDisplay" readonly value="₱0.00" />
                </div>
                <div class="col-md-6">
                    <label for="jobStatusDisplay" class="form-label">Job Status</label>
                    <input type="text" class="form-control" id="jobStatusDisplay" value="-- Select mechanic --" readonly />
                </div>
                <div class="col-md-6">
                    <label for="changeDisplay" class="form-label">Change</label>
                    <input type="text" class="form-control" id="changeDisplay" readonly value="₱0.00" />
                </div>
                <div class="col-md-6">
                    <label for="paymentStatusDisplay" class="form-label">Payment Status</label>
                    <input type="text" class="form-control" id="paymentStatusDisplay" readonly value="Unpaid" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="MechanicId" class="form-label"></label>
                <select asp-for="MechanicId" id="mechanicSelect" class="form-select">
                    <option value="">-- Select Mechanic --</option>
                    @foreach (var mechanic in mechanics)
                    {
                        bool busy = busyMechanicIds.Contains(mechanic.MechanicId);
                        <option value="@mechanic.MechanicId" data-job-status="@(busy ? "Pending" : "Still Working")" selected="@(Model.MechanicId == mechanic.MechanicId)">
                            @mechanic.MechanicName — @(busy ? "Working; next job Pending" : "Available; starts Still Working")
                        </option>
                    }
                </select>
                <span asp-validation-for="MechanicId" class="text-danger small"></span>
                <div class="form-text">The final job status is determined from current jobs when saved.</div>
            </div>

            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AmountReceived" class="form-label">Amount Received (₱)</label>
                <input asp-for="AmountReceived" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="AmountReceived" class="text-danger small"></span>
                <div class="form-text">Payment status and change are calculated automatically.</div>
            </div>

            <div class="form-actions">
                <input type="hidden" asp-for="SubmissionToken" />
                <button type="submit" class="btn btn-app-primary" id="createBtn">
                    <span>Create Service Job</span>
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('serviceSelect');
            var priceDisplay = document.getElementById('servicePriceDisplay');
            var totalDisplay = document.getElementById('totalPriceDisplay');
            var changeDisplay = document.getElementById('changeDisplay');
            var paymentStatusDisplay = document.getElementById('paymentStatusDisplay');
            var amountInput = document.getElementById('AmountReceived'); // generated by asp-for
            var mechanicSelect = document.getElementById('mechanicSelect');
            var jobStatusDisplay = document.getElementById('jobStatusDisplay');
            if (!select || !priceDisplay || !totalDisplay || !changeDisplay || !paymentStatusDisplay || !amountInput) return;

            var fmt = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' });

            function priceCents(element) {
                var cents = Number(element && element.getAttribute('data-price-cents'));
                return Number.isSafeInteger(cents) && cents >= 0 ? cents : 0;
            }

            function paymentCents(value) {
                var text = String(value || '').trim();
                if (!/^(?:\d+\.?\d{0,2}|\.\d{1,2})$/.test(text)) return 0;
                var parts = text.split('.');
                var cents = Number(parts[0] || '0') * 100 + Number((parts[1] || '').padEnd(2, '0'));
                return Number.isSafeInteger(cents) && cents >= 0 ? cents : 0;
            }

            function recalc() {
                var option = select.options[select.selectedIndex];
                var baseCents = priceCents(option);
                var receivedCents = paymentCents(amountInput.value);
                var changeCents = Math.max(0, receivedCents - baseCents);
                var paymentStatus = (receivedCents >= baseCents && receivedCents > 0) ? 'Paid' : 'Unpaid';

                priceDisplay.value = fmt.format(baseCents / 100);
                totalDisplay.value = fmt.format(baseCents / 100);
                changeDisplay.value = fmt.format(changeCents / 100);
                paymentStatusDisplay.value = paymentStatus;
            }

            select.addEventListener('change', recalc);
            amountInput.addEventListener('input', recalc);
            amountInput.addEventListener('change', recalc);

            if (mechanicSelect && jobStatusDisplay) {
                function updateJobStatus() {
                    var selected = mechanicSelect.options[mechanicSelect.selectedIndex];
                    jobStatusDisplay.value = selected && selected.getAttribute('data-job-status') || '-- Select mechanic --';
                }
                mechanicSelect.addEventListener('change', updateJobStatus);
                updateJobStatus();
            }

            document.querySelectorAll('.quick-service-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    select.value = this.getAttribute('data-service-id');
                    select.dispatchEvent(new Event('change'));
                });
            });

            // Prevent duplicate submissions
            var form = document.querySelector('form');
            var btn = document.getElementById('createBtn');
            form.addEventListener('submit', function () {
                btn.disabled = true;
                btn.innerHTML = '<span>Creating Service Job...</span>';
            });

            // Initialise displays
            recalc();
        })();
    </script>
}
