@model KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob
@using System.Globalization
@{
    ViewData["Title"] = $"Connect {Model.ServiceJobNumber} to Sale";
    var ph = CultureInfo.GetCultureInfo("en-PH");
}
<div class="page-header">
    <div>
        <h1>Connect @Model.ServiceJobNumber to a Sale</h1>
        <p>Link this service job to an existing sales transaction.</p>
    </div>
</div>

@if (Model.SalesTransaction != null)
{
    <div class="alert alert-warning py-2">
        This service job is currently connected to invoice
        <strong>#@Model.SalesTransaction.InvoiceNumber</strong>. Selecting another sale will move the link.
    </div>
}

<div class="card form-card">
    <div class="card-body">
        <form asp-action="ConnectToSale" asp-route-id="@Model.ServiceJobId" method="post">
            <dl class="row mb-3">
                <dt class="col-sm-3">Service Job ID</dt>
                <dd class="col-sm-9">@Model.ServiceJobNumber</dd>
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@Model.CustomerName</dd>
                <dt class="col-sm-3">Amount Received</dt>
                <dd class="col-sm-9">@Model.AmountReceived.ToString("C", ph)</dd>
            </dl>

            <div class="mb-3">
                <label for="transactionId" class="form-label">Select Sales Transaction</label>
                <select name="transactionId" id="transactionId" asp-items="ViewBag.TransactionId" class="form-select">
                    <option value="">-- Select Sale --</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    <span>Connect to Sale</span>
                </button>
                <a asp-action="Details" asp-route-id="@Model.ServiceJobId" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
