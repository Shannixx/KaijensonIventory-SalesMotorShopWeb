@model KaijensonIventory_SalesMotorShopWeb.ViewModels.ServiceJobFormViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Edit {Model.ServiceJobNumber}";
    var services = ViewBag.ServicesList as List<KaijensonIventory_SalesMotorShopWeb.Models.Service> ?? new List<KaijensonIventory_SalesMotorShopWeb.Models.Service>();
    var addOns = ViewBag.AddOnsList as List<KaijensonIventory_SalesMotorShopWeb.Models.Service> ?? new List<KaijensonIventory_SalesMotorShopWeb.Models.Service>();
    var ph = CultureInfo.GetCultureInfo("en-PH");
}
<div class="page-header">
    <div>
        <h1>Edit Service Job @Model.ServiceJobNumber</h1>
        <p>Update service job details and payment information.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>
            <input type="hidden" asp-for="ServiceJobId" />
            <input type="hidden" asp-for="SubmissionToken" />

            <div class="mb-3">
                <label asp-for="ServiceId" class="form-label">Base Service</label>
                <select asp-for="ServiceId" id="serviceSelect" class="form-select">
                    <option value="">-- Select Base Service --</option>
                    @foreach (var s in services)
                    {
                        <option value="@s.ServiceId" data-price-cents="@((s.ServicePrice * 100m).ToString("0", CultureInfo.InvariantCulture))" selected="@(Model.ServiceId == s.ServiceId)">
                            @s.ServiceName — ₱@s.ServicePrice.ToString("N2", ph)
                        </option>
                    }
                </select>
                <span asp-validation-for="ServiceId" class="text-danger small"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6">Add-ons (optional)</legend>
                @foreach (var addOn in addOns)
                {
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input service-addon-check" id="addOn_@addOn.ServiceId"
                               name="SelectedAddOnIds" value="@addOn.ServiceId"
                               data-price-cents="@((addOn.ServicePrice * 100m).ToString("0", CultureInfo.InvariantCulture))"
                               checked="@(Model.SelectedAddOnIds.Contains(addOn.ServiceId))" />
                        <label class="form-check-label" for="addOn_@addOn.ServiceId">@addOn.ServiceName — ₱@addOn.ServicePrice.ToString("N2", ph)</label>
                    </div>
                }
                @if (!addOns.Any())
                {
                    <div class="form-text">No add-ons are available.</div>
                }
                <span asp-validation-for="SelectedAddOnIds" class="text-danger small"></span>
            </fieldset>

            <div class="mb-3">
                <label for="servicePriceDisplay" class="form-label">Base Service Price</label>
                <input type="text" class="form-control" id="servicePriceDisplay" value="₱0.00" readonly />
                <div class="form-text">Retained selections keep their saved prices. Newly selected services use current prices.</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="totalPriceDisplay" class="form-label">Total Service Price</label>
                    <input type="text" class="form-control" id="totalPriceDisplay" readonly value="₱0.00" />
                </div>
                <div class="col-md-6">
                    <label for="changeDisplay" class="form-label">Change</label>
                    <input type="text" class="form-control" id="changeDisplay" readonly value="₱0.00" />
                </div>
                <div class="col-md-6">
                    <label for="paymentStatusDisplay" class="form-label">Payment Status</label>
                    <input type="text" class="form-control" id="paymentStatusDisplay" readonly value="Unpaid" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="MechanicId" class="form-label"></label>
                <select asp-for="MechanicId" asp-items="ViewBag.MechanicId" class="form-select">
                    <option value="">-- Select Mechanic --</option>
                </select>
                <span asp-validation-for="MechanicId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <input type="text" class="form-control" value="@Model.Status" readonly />
                @if (Model.CompletedDate.HasValue)
                {
                    <div class="form-text">Completed on @Model.CompletedDate.Value.ToString("MMMM dd, yyyy"). The completion date is never overwritten.</div>
                }
                else
                {
                    <div class="form-text">When reassigned, this job waits as Pending if the new mechanic has an active job; otherwise it becomes Still Working. Only a working job can be marked Done.</div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="AmountReceived" class="form-label"></label>
                <input asp-for="AmountReceived" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="AmountReceived" class="text-danger small"></span>
                <div class="form-text">Payment status is recomputed automatically from the total base service and add-on charges.</div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Save Changes</span>
                </button>
                <a asp-action="Details" asp-route-id="@Model.ServiceJobId" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('serviceSelect');
            var priceDisplay = document.getElementById('servicePriceDisplay');
            var totalDisplay = document.getElementById('totalPriceDisplay');
            var changeDisplay = document.getElementById('changeDisplay');
            var paymentStatusDisplay = document.getElementById('paymentStatusDisplay');
            var amountInput = document.getElementById('AmountReceived');
            var addOnInputs = document.querySelectorAll('.service-addon-check');
            if (!select || !priceDisplay || !totalDisplay || !changeDisplay || !paymentStatusDisplay || !amountInput) return;

            var fmt = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' });

            function priceCents(element) {
                var cents = Number(element && element.getAttribute('data-price-cents'));
                return Number.isSafeInteger(cents) && cents >= 0 ? cents : 0;
            }

            function paymentCents(value) {
                var text = String(value || '').trim();
                if (!/^(?:\d+\.?\d{0,2}|\.\d{1,2})$/.test(text)) return 0;
                var parts = text.split('.');
                var cents = Number(parts[0] || '0') * 100 + Number((parts[1] || '').padEnd(2, '0'));
                return Number.isSafeInteger(cents) && cents >= 0 ? cents : 0;
            }

            function recalc() {
                var option = select.options[select.selectedIndex];
                var baseCents = priceCents(option);
                var totalCents = baseCents;
                addOnInputs.forEach(function (input) {
                    if (input.checked) totalCents += priceCents(input);
                });
                var receivedCents = paymentCents(amountInput.value);
                var changeCents = Math.max(0, receivedCents - totalCents);
                var paymentStatus = (receivedCents >= totalCents && receivedCents > 0) ? 'Paid' : 'Unpaid';

                priceDisplay.value = fmt.format(baseCents / 100);
                totalDisplay.value = fmt.format(totalCents / 100);
                changeDisplay.value = fmt.format(changeCents / 100);
                paymentStatusDisplay.value = paymentStatus;
            }

            select.addEventListener('change', recalc);
            amountInput.addEventListener('input', recalc);
            amountInput.addEventListener('change', recalc);
            addOnInputs.forEach(function (input) { input.addEventListener('change', recalc); });
            recalc();
        })();
    </script>
}
