@model KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob
@using System.Globalization
@{
    ViewData["Title"] = $"Service Job {Model.ServiceJobNumber}";
    var histories = ViewBag.Histories as List<KaijensonIventory_SalesMotorShopWeb.Models.ServiceHistory> ?? new List<KaijensonIventory_SalesMotorShopWeb.Models.ServiceHistory>();
    decimal serviceAmount = Model.Service?.ServicePrice ?? 0m;
    decimal remainingBalance = Math.Max(0m, serviceAmount - Model.AmountReceived);
    bool isStillWorking = Model.Status == KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob.StatusStillWorking;
    string StatusBadge(string s) => s == KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob.StatusFinished
        ? "<span class=\"badge bg-success\">Finished</span>"
        : "<span class=\"badge bg-warning text-dark\">Still Working</span>";
    string PaymentBadge(string s) => s == KaijensonIventory_SalesMotorShopWeb.Models.ServiceJob.PaymentPaid
        ? "<span class=\"badge bg-success\">Paid</span>"
        : "<span class=\"badge bg-danger\">Unpaid</span>";
    var ph = CultureInfo.GetCultureInfo("en-PH");
}
<div class="page-header">
    <div>
        <h1>Service Job @Model.ServiceJobNumber</h1>
        <p>Service job information, work history and sales link.</p>
    </div>
    <div class="d-flex gap-2">
        @if (isStillWorking)
        {
            <button type="button" class="btn btn-success"
                    data-mark-done
                    data-job-id="@Model.ServiceJobId"
                    data-job-number="@Model.ServiceJobNumber"
                    data-service="@Model.Service?.ServiceName"
                    data-price="@serviceAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    data-received="@Model.AmountReceived.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    data-return-url="@(Context.Request.Path + Context.Request.QueryString)">
                <i class="bi bi-check-circle"></i> Mark Done
            </button>
        }
        else
        {
            <button type="button" class="btn btn-primary" onclick="openServiceReceiptPreview(@Model.ServiceJobId, '@Model.ServiceJobNumber')"><i class="bi bi-receipt"></i> View Receipt</button>
                        <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print Receipt</button>
                        <a asp-action="ReceiptPdf" asp-route-id="@Model.ServiceJobId" class="btn btn-outline-primary"><i class="bi bi-file-earmark-pdf"></i> Download PDF</a>
        }
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to Service Jobs</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Service Job ID</dt>
            <dd class="col-sm-9"><span class="fw-medium">@Model.ServiceJobNumber</span></dd>

            <dt class="col-sm-3">Service Name</dt>
            <dd class="col-sm-9">@Model.Service?.ServiceName</dd>

            <dt class="col-sm-3">Mechanic</dt>
            <dd class="col-sm-9">@Model.Mechanic?.MechanicName</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Html.Raw(StatusBadge(Model.Status))</dd>

            <dt class="col-sm-3">Payment</dt>
            <dd class="col-sm-9">@Html.Raw(PaymentBadge(Model.PaymentStatus))</dd>

            <dt class="col-sm-3">Service Amount</dt>
            <dd class="col-sm-9">@serviceAmount.ToString("C", ph)</dd>

            <dt class="col-sm-3">Amount Received</dt>
            <dd class="col-sm-9">@Model.AmountReceived.ToString("C", ph)</dd>

            <dt class="col-sm-3">Change</dt>
            <dd class="col-sm-9">@Model.ChangeAmount.ToString("C", ph)</dd>

            <dt class="col-sm-3">Service Date</dt>
            <dd class="col-sm-9">@Model.ServiceDate.ToString("MMMM dd, yyyy")</dd>

            @if (Model.CompletedDate.HasValue)
            {
                <dt class="col-sm-3">Completed Date</dt>
                <dd class="col-sm-9">@Model.CompletedDate.Value.ToString("MMMM dd, yyyy")</dd>
            }
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body p-0">
        <div class="page-header m-0 p-3 pb-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">SERVICE HISTORY</h5>
            
        </div>
        <div class="table-container">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Work</th>
                        <th class="text-end">Amount</th>
                        <th>Payment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in histories)
                    {
                        <tr>
                            <td>@h.WorkDate.ToString("ddd, MMM dd, yyyy")</td>
                            <td>@h.Description</td>
                            <td class="text-end">@h.AmountReceived.ToString("N2", ph)</td>
                            <td>@Html.Raw(PaymentBadge(h.PaymentStatus))</td>
                        </tr>
                    }
                    @if (!histories.Any())
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted">No work history recorded yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_MarkDoneModal" />
