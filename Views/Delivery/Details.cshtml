@model DeliveryViewModel
@{
    ViewData["Title"] = "Delivery Details";
    string badgeClass = Model.Status switch
    {
        "Pending" => "bg-warning",
        "Approved" => "bg-primary",
        "Delivered" => "bg-success",
        "Partially Delivered" => "bg-warning",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };}

<div class="page-header">
    <div>
        <h1>@Model.PurchaseOrderNumber</h1>
        <p>Delivery details.</p>
    </div>
    <div class="d-flex gap-2">
        @{
    var showForm = (Model.Status == "Pending" || Model.Status == "Partially Delivered") && Model.Items.Any(i => i.Quantity - i.ReceivedQuantity > 0);
}
@if (showForm)
{
    <form asp-action="Receive" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DeliveryId" value="@Model.DeliveryId" />
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Ordered</th>
                    <th>Received</th>
                    <th>Remaining</th>
                    <th>Receive Now</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var remaining = item.Quantity - item.ReceivedQuantity;
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.ReceivedQuantity</td>
                        <td>@remaining</td>
                        <td>
                            <input type="number" name="ReceiveQuantities[@item.PurchaseOrderItemId]" min="0" max="@remaining" class="form-control" value="@remaining" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit" class="btn btn-success" onclick="return confirm('Process this delivery? Stock will be updated.');">
            <i class="bi bi-check-all"></i> Receive
        </button>
    </form>
}
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Delivery</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-icon primary"><i class="bi bi-receipt"></i></div>
            <div class="metric-info">
                <p class="metric-label">Status</p>
                <h3 class="metric-value"><span class="badge @badgeClass" style="font-size:14px;padding:4px 14px;">@Model.Status</span></h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-icon info"><i class="bi bi-truck"></i></div>
            <div class="metric-info">
                <p class="metric-label">Supplier</p>
                <h3 class="metric-value" style="font-size:1.1rem;">@(Model.SupplierName ?? "N/A")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-icon accent"><i class="bi bi-box-seam"></i></div>
            <div class="metric-info">
                <p class="metric-label">Order Date</p>
                <h3 class="metric-value" style="font-size:1.1rem;">@Model.OrderDate.ToString("MMM dd, yyyy")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card">
            <div class="metric-icon warning-light"><i class="bi bi-calendar-check"></i></div>
            <div class="metric-info">
                <p class="metric-label">Delivered Date</p>
                <h3 class="metric-value" style="font-size:1.1rem;">@(Model.DeliveredDate?.ToString("MMM dd, yyyy") ?? "-")</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Ordered Products</span>
        <span class="fw-bold">Total Items: @Model.Items.Count</span>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Brand</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@idx</td>
                                <td><span class="fw-medium">@item.ProductName</span></td>
                                <td>@(item.Category ?? "-")</td>
                                <td>@(item.Brand ?? "-")</td>
                                <td class="fw-semibold">@item.Quantity</td>
                            </tr>
                            idx++;
                        }
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="5" class="text-center py-3 text-muted">No items.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
