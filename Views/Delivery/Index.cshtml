@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.ViewModels.DeliveryViewModel>
@{ ViewData["Title"] = "Delivery"; }

<div class="page-header">
    <div>
        <h1>Delivery</h1>
        <p>Purchase order deliveries.</p>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>PO Number</th>
                        <th>Supplier</th>
                        <th>Order Date</th>
                        <th>Products</th>
                        <th>Status</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-medium">@item.PurchaseOrderNumber</span></td>
                            <td>@item.SupplierName</td>
                            <td>@item.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td class="text-center">
    @{
        var count = item.Items.Count;
        var label = count == 1 ? "Product" : "Products";
    }
    @count @label
</td>
                            @{var badgeClass = item.Status switch
    {
        "Pending" => "bg-warning",
        "Partially Delivered" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}
                    <td><span class="badge @badgeClass">@item.Status</span></td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.DeliveryId" asp-route-archived="@(ViewBag.ShowArchived == true ? "true" : "false")" class="btn btn-icon btn-icon-deliver" title="View Delivery" aria-label="View delivery for @item.PurchaseOrderNumber"><i class="bi bi-truck"></i></a>
                                    @if (Context.Session.GetString("StaffRole") == "Admin" && ViewBag.ShowArchived != true)
                                    {
                                        <form asp-action="Archive" asp-route-id="@item.DeliveryId" method="post" id="archive-delivery-@item.DeliveryId" class="action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="archive-delivery-@item.DeliveryId" data-delete-record-name="@item.PurchaseOrderNumber" data-delete-entity-name="delivery" title="Archive delivery" aria-label="Archive delivery for @item.PurchaseOrderNumber"><i class="bi bi-archive"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No deliveries found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
