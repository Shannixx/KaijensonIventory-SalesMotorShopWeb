@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.ViewModels.DeliveryViewModel>
@{ ViewData["Title"] = "Delivery"; }

<div class="page-header">
    <div>
        <h1>Delivery</h1>
        <p>Purchase orders awaiting delivery.</p>
    </div>
    
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>PO Number</th>
                        <th>Supplier</th>
                        <th>Order Date</th>
                        <th>Products</th>
                        <th>Status</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-medium">@item.PurchaseOrderNumber</span></td>
                            <td>@item.SupplierName</td>
                            <td>@item.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>
    @item.Items.Count
    @foreach (var it in item.Items) {
        <span class="badge bg-secondary ms-1">@it.ProductName</span>
    }
</td>
                            @{var badgeClass = item.Status == "Pending" ? "bg-warning" : item.Status == "Delivered" ? "bg-success" : "bg-primary";}
                    <td><span class="badge @badgeClass">@item.Status</span></td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.DeliveryId" class="btn btn-icon btn-icon-deliver" title="View Delivery" aria-label="View delivery for @item.PurchaseOrderNumber"><i class="bi bi-truck"></i></a>
                                    @if (item.Status == "Pending") {
                                        <form asp-action="MarkDelivered" asp-route-id="@item.DeliveryId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-icon btn-icon-deliver" title="Mark as Delivered" aria-label="Mark as Delivered for @item.PurchaseOrderNumber"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No purchase orders awaiting delivery.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
