@model Service
@{ ViewData["Title"] = "Edit Service"; }
<div class="page-header">
    <div>
        <h1>Edit Service</h1>
        <p>Update service details.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ServiceId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="ServiceName" class="form-label"></label>
                <input asp-for="ServiceName" class="form-control" />
                <span asp-validation-for="ServiceName" class="text-danger small"></span>
            </div>

                <div class="mb-3">
                    <label asp-for="ServicePrice" class="form-label"></label>
                    <input asp-for="ServicePrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="ServicePrice" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            <div class="mb-3">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <input asp-for="DurationMinutes" class="form-control" type="number" min="0" />
                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Save Changes</span>
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
