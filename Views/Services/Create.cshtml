@model Service
@{ ViewData["Title"] = "Create Service"; }
<div class="page-header">
    <div>
        <h1>Create Service</h1>
        <p>Add a new service.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="ServiceName" class="form-label"></label>
                <input asp-for="ServiceName" class="form-control" />
                <span asp-validation-for="ServiceName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ServicePrice" class="form-label"></label>
                <input asp-for="ServicePrice" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="ServicePrice" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MechanicId" class="form-label"></label>
                <select asp-for="MechanicId" asp-items="ViewBag.MechanicId" class="form-select">
                    <option value="">-- Select Mechanic --</option>
                </select>
                <span asp-validation-for="MechanicId" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Create Service</span>
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
