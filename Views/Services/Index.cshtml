@model IEnumerable<Service>
@using System.Globalization
@{
    ViewData["Title"] = "Services";
    string? currentFilter = ViewData["CurrentFilter"] as string;
    var ph = CultureInfo.GetCultureInfo("en-PH");
    var mechanics = ViewBag.MechanicId as SelectList;
}
<div class="page-header">
    <div>
        <h1>Services</h1>
        <p>Manage service types offered to customers.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-plus-circle"></i> Full Form</a>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">
            <i class="bi bi-plus-lg"></i> Add Service
        </button>
        <a asp-controller="ServiceJobs" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-wrench-adjustable"></i> Service Jobs</a>
    </div>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Services",
        QueryValue = currentFilter,
        Placeholder = "Search by name...",
        AriaLabel = "Search services",
        InputId = "searchServices",
        ClearActionName = "Index",
        ClearControllerName = "Services"
    };
}
<partial name="_SearchToolbar" model="searchModel" />

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Service Name</th>
                        <th>Price</th>
                        <th>Mechanic</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ServiceId</td>
                            <td>@item.ServiceName</td>
                            <td>@item.ServicePrice.ToString("C", ph)</td>
                            <td>@item.Mechanic?.MechanicName</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.ServiceId" class="btn btn-icon btn-icon-view" title="View Service Details" aria-label="View @item.ServiceName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.ServiceId" class="btn btn-icon btn-icon-edit" title="Edit Service" aria-label="Edit @item.ServiceName"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.ServiceId" method="post" id="delete-service-@item.ServiceId" class="action-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-service-@item.ServiceId" data-delete-record-name="@item.ServiceName" data-delete-entity-name="service" title="Delete service" aria-label="Delete service @item.ServiceName"><i class="bi bi-trash"></i></button>
                                    </form>
                                    <a asp-controller="ServiceJobs" asp-action="Index" asp-route-serviceId="@item.ServiceId" class="btn btn-icon btn-outline-secondary" title="Service Jobs for this service" aria-label="Service jobs for @item.ServiceName"><i class="bi bi-wrench-adjustable"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No services found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />

@* ─── Inline "Add Service" modal: created services are immediately usable by Service Jobs ─── *@
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addServiceModalLabel">Add Service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="quickServiceName">Service Name</label>
                        <input id="quickServiceName" name="ServiceName" class="form-control" placeholder="e.g. Oil Change" required maxlength="150" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="quickServicePrice">Price (&#8369;)</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input id="quickServicePrice" name="ServicePrice" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="quickServiceMechanic">Default Mechanic</label>
                        @if (mechanics != null)
                        {
                            <select id="quickServiceMechanic" name="MechanicId" asp-items="mechanics" class="form-select" required>
                                <option value="">-- Select Mechanic --</option>
                            </select>
                        }
                        else
                        {
                            <select id="quickServiceMechanic" name="MechanicId" class="form-select" required>
                                <option value="">-- Select Mechanic --</option>
                            </select>
                        }
                        <div class="form-text">The service job can still be assigned to any mechanic at creation time.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-app-primary">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        <span>Add Service</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
