@model Service
@{
    ViewData["Title"] = "Service Details";
    var role = Context.Session.GetString("StaffRole");
    bool canManage = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
}
<div class="page-header">
    <div>
        <h1>Service Details</h1>
        <p>View service information.</p>
    </div>
    <div class="d-flex gap-2">
        @if (canManage && !Model.IsDeleted)
        {
            <a asp-action="Edit" asp-route-id="@Model.ServiceId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        }
        <a asp-action="Index" asp-route-archived="@(ViewBag.ShowArchived == true ? "true" : "false")" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.ServiceId</dd>

                <dt class="col-sm-3">Service Name</dt>
                <dd class="col-sm-9">@Model.ServiceName</dd>

                <dt class="col-sm-3">Service Type</dt>
                <dd class="col-sm-9">@(Model.IsAddOn ? "Add-on" : "Base Service")</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">@Model.ServicePrice.ToString("N2")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
                <dt class="col-sm-3">Date Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>
                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@(Model.CreatedByStaff?.StaffName ?? "Unknown")</dd>
            </dl>
    </div>
</div>
