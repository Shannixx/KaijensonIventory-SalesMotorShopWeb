@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Supplier>
@{ ViewData["Title"] = "Suppliers"; }

<div class="page-header">
    <div>
        <h1>Suppliers</h1>
        <p>Manage suppliers.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Supplier</a>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Suppliers",
        QueryValue = ViewData["CurrentFilter"] as string,
        Placeholder = "Search by company, contact person or number...",
        AriaLabel = "Search suppliers",
        InputId = "searchSuppliers",
        ClearActionName = "Index",
        ClearControllerName = "Suppliers"
    };
}
<partial name="_SearchToolbar" model="searchModel" />

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Company Name</th>
                        <th>Contact Person</th>
                        <th>Contact No.</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SupplierId</td>
                            <td>@item.CompanyName</td>
                            <td>@item.ContactPerson</td>
                            <td>@item.ContactNumber</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-icon btn-icon-view" title="View Supplier Details" aria-label="View @item.CompanyName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-icon btn-icon-edit" title="Edit Supplier" aria-label="Edit @item.CompanyName"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.SupplierId" method="post" id="delete-supplier-@item.SupplierId" class="action-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-supplier-@item.SupplierId" data-delete-record-name="@item.CompanyName" data-delete-entity-name="supplier" title="Delete supplier" aria-label="Delete supplier @item.CompanyName"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No suppliers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
