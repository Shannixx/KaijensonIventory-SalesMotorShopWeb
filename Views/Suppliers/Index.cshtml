@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Supplier>
@{ ViewData["Title"] = "Suppliers"; }

<div class="page-header">
    <div>
        <h1>Suppliers</h1>
        <p>Manage suppliers.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Supplier</a>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Suppliers",
        QueryValue = ViewData["CurrentFilter"] as string,
        Placeholder = "Search by company, contact person or number...",
        AriaLabel = "Search suppliers",
        InputId = "searchSuppliers",
        ClearActionName = "Index",
        ClearControllerName = "Suppliers"
    };
}
<form asp-action="Index" asp-controller="Suppliers" method="get" class="search-toolbar-form d-flex align-items-center mb-3">
    <div class="search-toolbar-field me-2">
        <label class="visually-hidden" for="searchSuppliers">Search suppliers</label>
        <input type="search" id="searchSuppliers" name="searchString" value="@(ViewData["CurrentFilter"] as string)" class="form-control" placeholder="Search by company, contact person, number or email..." aria-label="Search suppliers" autocomplete="off" />
    </div>
    <div class="me-2">
        @{
    var statusFilter = (ViewData["StatusFilter"] as string) ?? "All";
}
<select name="statusFilter" class="form-select" aria-label="Status filter">
    @if (statusFilter == "All") {
        <option value="All" selected>All</option>
    } else {
        <option value="All">All</option>
    }
    @if (statusFilter == "Active") {
        <option value="Active" selected>Active</option>
    } else {
        <option value="Active">Active</option>
    }
    @if (statusFilter == "Inactive") {
        <option value="Inactive" selected>Inactive</option>
    } else {
        <option value="Inactive">Inactive</option>
    }
</select>
    </div>
    <button type="submit" class="btn btn-search me-2"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
    <a asp-action="Index" asp-controller="Suppliers" class="btn btn-clear"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</a>
</form>

<div class="card">
    @Html.AntiForgeryToken()
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table supplier-table">
                <thead>
                    <tr>
                        <th class="text-center">ID</th>
                        <th class="text-center">Company Name</th>
                        <th class="text-center">Status</th>
                        <th class="text-center actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.SupplierId</td>
                            <td class="text-center">@item.CompanyName</td>
<td class="text-center">
    @if (item.Status == "Active") {
        <span class="badge bg-success">Active</span>
    } else {
        <span class="badge bg-secondary">Inactive</span>
    }
</td>
                            <td class="action-cell text-center">
<div class="action-buttons">
                                      <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-icon btn-icon-view" title="View Supplier Details" aria-label="View @item.CompanyName"><i class="bi bi-eye"></i></a>
                                      <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-icon btn-icon-edit" title="Edit Supplier" aria-label="Edit @item.CompanyName"><i class="bi bi-pencil"></i></a>
                                      <form asp-action="ToggleStatus" asp-route-id="@item.SupplierId" method="post" class="d-inline">
                                          @Html.AntiForgeryToken()
                                          <button type="submit" class="btn btn-icon btn-icon-toggle" title="Toggle Supplier Status" aria-label="Toggle status for @item.CompanyName"><i class="bi bi-arrow-repeat"></i></button>
                                      </form>
                                      <form asp-action="Delete" asp-route-id="@item.SupplierId" method="post" id="delete-supplier-@item.SupplierId" class="action-form">
                                          @Html.AntiForgeryToken()
                                          <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-supplier-@item.SupplierId" data-delete-record-name="@item.CompanyName" data-delete-entity-name="supplier" title="Delete supplier" aria-label="Delete supplier @item.CompanyName"><i class="bi bi-trash"></i></button>
                                      </form>
                                  </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No suppliers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />

