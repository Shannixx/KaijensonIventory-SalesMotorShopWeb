@model KaijensonIventory_SalesMotorShopWeb.ViewModels.SaleDetailsViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Sale Details";
}
<div class="page-header mb-3">
    <div>
        <h1>Sale Details</h1>
        <p>View the completed transaction details.</p>
    </div>
    <a asp-action="Search" class="btn btn-outline-primary"><i class="bi bi-house"></i> Home</a>
</div>
<p><strong>Receipt #:</strong> @Model.Transaction.InvoiceNumber</p>
<p><strong>Date:</strong> @Model.Transaction.TransactionDate</p>
<p><strong>Staff:</strong> @Model.Transaction.Staff?.StaffName</p>
<p><strong>Customer:</strong> @(string.IsNullOrWhiteSpace(Model.Transaction.CustomerName) ? "Walk‑in" : Model.Transaction.CustomerName)</p>
<div class="table-responsive mb-3">
    <table class="table table-bordered align-middle">
    <thead><tr><th>Product</th><th class="text-center">Qty</th><th class="text-end">Unit Price</th><th class="text-end">Subtotal</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.Product.ProductName</td>
            <td>@item.Quantity</td>
            <td class="text-end">@item.UnitPrice.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
            <td class="text-end">@item.Subtotal.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
        </tr>
    }
    </tbody>
</table></div>
<p><strong>Total:</strong> @Model.Transaction.TotalAmount.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</p>
<p><strong>Paid:</strong> @Model.Transaction.AmountPaid.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</p>
<p><strong>Change:</strong> @Model.Transaction.Change.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</p>
<div class="mt-3">
    <button type="button" class="btn btn-outline-primary me-2" onclick="openReceiptPreview(@Model.Transaction.TransactionId, '@Model.Transaction.InvoiceNumber')"><i class="bi bi-eye"></i> View Receipt</button>
    <button type="button" class="btn btn-primary" onclick="openReceiptPrint(@Model.Transaction.TransactionId, '@Model.Transaction.InvoiceNumber')"><i class="bi bi-printer"></i> Print Receipt</button>
</div>