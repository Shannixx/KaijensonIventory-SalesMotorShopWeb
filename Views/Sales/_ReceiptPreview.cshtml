@model KaijensonIventory_SalesMotorShopWeb.ViewModels.SaleDetailsViewModel
@using System.Linq
@{
    string staffName = Model.Transaction.Staff?.StaffName ?? "";
    string cust = string.IsNullOrWhiteSpace(Model.Transaction.CustomerName) ? "Walk‑in" : Model.Transaction.CustomerName;
    var ph = System.Globalization.CultureInfo.GetCultureInfo("en-PH");
    var items = Model.Items ?? System.Linq.Enumerable.Empty<KaijensonIventory_SalesMotorShopWeb.Models.SalesItem>();
    decimal subtotal = items.Any() ? items.Sum(i => i.Subtotal) : Model.Transaction.TotalAmount;
}
<div class="print-preview-wrapper receipt-preview">
    <div class="receipt-paper">
        <div class="receipt-shop-name">KAIJENSON MOTOR SHOP</div>
        <div class="receipt-doc-title">Sales Receipt</div>

        <hr class="receipt-divider" />

        <div class="receipt-meta">
            <div class="receipt-meta-row">
                <span class="receipt-meta-label">Receipt No.</span>
                <span class="receipt-meta-value">@Model.Transaction.InvoiceNumber</span>
            </div>
            <div class="receipt-meta-row">
                <span class="receipt-meta-label">Date</span>
                <span class="receipt-meta-value">@Model.Transaction.TransactionDate.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="receipt-meta-row">
                <span class="receipt-meta-label">Staff</span>
                <span class="receipt-meta-value">@staffName</span>
            </div>
            <div class="receipt-meta-row">
                <span class="receipt-meta-label">Customer</span>
                <span class="receipt-meta-value">@cust</span>
            </div>
        </div>

        <hr class="receipt-divider" />

        <table class="receipt-items">
            <thead>
                <tr>
                    <th class="ri-product">Product</th>
                    <th class="ri-qty">Qty</th>
                    <th class="ri-price">Price</th>
                    <th class="ri-amt">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Product?.ProductName</td>
                        <td class="ri-qty">@item.Quantity</td>
                        <td class="ri-price">@item.UnitPrice.ToString("C", ph)</td>
                        <td class="ri-amt">@item.Subtotal.ToString("C", ph)</td>
                    </tr>
                    if (Model.SerialNumbersByProduct != null && Model.SerialNumbersByProduct.TryGetValue(item.ProductId, out var serialList) && serialList.Any())
                    {
                        <tr class="receipt-serial-row">
                            <td colspan="4">Serial: @string.Join(", ", serialList)</td>
                        </tr>
                    }
                }
                @if (!items.Any())
                {
                    <tr><td colspan="4" class="receipt-no-items">No items to display</td></tr>
                }
            </tbody>
        </table>

        <hr class="receipt-divider receipt-divider-strong" />

        <div class="receipt-totals">
            <div class="receipt-total-row">
                <span>Subtotal</span>
                <span>@subtotal.ToString("C", ph)</span>
            </div>
            <div class="receipt-total-row receipt-grand-total">
                <span>TOTAL</span>
                <span>@Model.Transaction.TotalAmount.ToString("C", ph)</span>
            </div>
            <div class="receipt-total-row">
                <span>Cash / Paid</span>
                <span>@Model.Transaction.AmountPaid.ToString("C", ph)</span>
            </div>
            <div class="receipt-total-row">
                <span>Change</span>
                <span>@Model.Transaction.Change.ToString("C", ph)</span>
            </div>
        </div>

        <hr class="receipt-divider" />

        <div class="receipt-thanks">Thank you for your purchase.</div>
    </div>
</div>
<link rel="stylesheet" href="~/css/print.css" />
