@model KaijensonIventory_SalesMotorShopWeb.ViewModels.SaleDetailsViewModel
@using System.Linq
@{
    string staffName = Model.Transaction.Staff?.StaffName ?? "";
    string cust = string.IsNullOrWhiteSpace(Model.Transaction.CustomerName) ? "Walk‑in" : Model.Transaction.CustomerName;
}
<div class="print-preview-wrapper">
    <div class="print-preview-header">
        <div>
            <h1 class="print-shop-name">KAIJENSON MOTOR SHOP</h1>
            <p class="print-receipt-title">Sales Receipt</p>
        </div>
        <div class="print-header-info">
            <div class="print-receipt-number">Receipt #: @Model.Transaction.InvoiceNumber</div>
            <div class="print-receipt-date">Date: @Model.Transaction.TransactionDate.ToString("MMM dd, yyyy")</div>
            <div class="print-receipt-staff">Staff: @staffName</div>
            <div class="print-receipt-customer">Customer: @cust</div>
        </div>
    </div>

    <hr class="print-separator" />

    <div class="print-items-section">
        <table class="table table-bordered print-items-table">
            <thead>
                <tr class="print-table-header">
                    <th class="text-center">#</th>
                    <th>Product</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @{int idx = 1;}
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center">@idx</td>
                        <td>@item.Product?.ProductName</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.UnitPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                        <td class="text-end">@item.Subtotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                    </tr>
                    idx++;
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="text-center py-3 text-muted">No items.</td></tr>
                }
            </tbody>
            <tfoot>
                <tr class="print-total-row">
                    <td colspan="4" class="text-end fw-bold">Total:</td>
                    <td class="text-end fw-bold">@Model.Transaction.TotalAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                </tr>
                <tr>
                    <td colspan="4" class="text-end fw-bold">Paid:</td>
                    <td class="text-end fw-bold">@Model.Transaction.AmountPaid.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                </tr>
                <tr>
                    <td colspan="4" class="text-end fw-bold">Change:</td>
                    <td class="text-end fw-bold">@Model.Transaction.Change.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="text-center mt-4">
        <p>Thank you for your purchase.</p>
    </div>
</div>
<link rel="stylesheet" href="~/css/print.css" />
