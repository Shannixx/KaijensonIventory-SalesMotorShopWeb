@model KaijensonIventory_SalesMotorShopWeb.Services.ProductListResult
@using KaijensonIventory_SalesMotorShopWeb.Extensions
@using System.Linq
@{
    var cart = Context.Session.GetObject<CartViewModel>("Cart") ?? new CartViewModel();
}
@{
    ViewData["Title"] = "Product Search";
}
<div class="page-header mb-3">
    <div>
        <h1>Product Search</h1>
        <p>Search and add products to the purchase order.</p>
    </div>
    <a asp-action="Search" class="btn btn-outline-primary"><i class="bi bi-house"></i> Home</a>
</div>
<form method="get" asp-action="Search" class="d-flex flex-wrap align-items-center mb-3">
    <input type="text" name="query" class="form-control me-sm-2" placeholder="Search products..." value='@Context.Request.Query["query"]' />
    <button type="submit" class="btn btn-primary mt-2 mt-sm-0">Search</button>
    <a asp-action="Search" class="btn btn-outline-secondary mt-2 mt-sm-0 ms-sm-2">Clear</a>
</form>
<div class="table-responsive mb-3">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th style="width:30%" class="text-start">Name</th>
                <th style="width:15%" class="text-start">Brand</th>
                <th style="width:15%" class="text-start">Category</th>
                <th style="width:10%" class="text-end">Price</th>
                <th style="width:10%" class="text-center">Stock</th>
                <th style="width:20%" class="text-center">Action</th>
            </tr>
        </thead>
    <tbody>
    @foreach (var p in Model.Items)
    {
        <tr class="align-middle">
            <td>@p.ProductName</td>
            <td>@p.Brand</td>
            <td>@p.Category?.CategoryName</td>
            <td class="text-end">@p.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
            <td class="text-center">@p.QuantityOnHand</td>
            <td>
                <form asp-action="AddToCart" method="post" class="d-inline">
                    <input type="hidden" name="productId" value="@p.ProductId" />
                    <div class="d-flex align-items-center gap-2 justify-content-center">
                        <input type="number" name="quantity" min="1" max="@p.QuantityOnHand" value="@(cart.Items.FirstOrDefault(i => i.ProductId == p.ProductId)?.Quantity ?? 1)" class="form-control w-50" style="max-width:80px;" />
                        <button type="submit" class="btn btn-success btn-sm">Add</button>
                    </div>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table></div>