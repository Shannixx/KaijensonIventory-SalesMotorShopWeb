@model KaijensonIventory_SalesMotorShopWeb.ViewModels.CustomerPurchaseOrderViewModel
@using KaijensonIventory_SalesMotorShopWeb.Extensions
@using System.Linq
@using KaijensonIventory_SalesMotorShopWeb.ViewModels
@using KaijensonIventory_SalesMotorShopWeb.Models
@{
    var cart = Model.Cart;
}
@{
    ViewData["Title"] = "Product Search";
}
@if (!(ViewBag.IsReorder == true && ViewBag.ReorderProduct != null))
{
    <div class="page-header mb-3">
        <div>
            <h1>Customer Purchase Order</h1>
            <p>Search and add products to the purchase order.</p>
        </div>
    </div>
}

else
{
    @await Html.PartialAsync("_SearchToolbar", new SearchToolbarViewModel {
        ActionName = "Search",
        ControllerName = "Sales",
        QueryParameterName = "query",
        QueryValue = Context.Request.Query["query"],
        Placeholder = "Search products...",
        ClearActionName = "Search",
        ClearControllerName = "Sales"
    })
}
@if (ViewBag.IsReorder == true && ViewBag.ReorderProduct != null)
{
    <div class="page-header mb-3">
        <div>
            <h1>Create Purchase Order</h1>
            <p>Reorder Product</p>
        </div>
    </div>
    var p = (Product)ViewBag.ReorderProduct;
    <div class="card form-card form-card-wide">
        <div class="card-body">
            <form asp-controller="PurchaseOrders" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SupplierId" value="@p.SupplierId" />
                <input type='hidden' name='OrderDate' value='@DateTime.Now.ToString("yyyy-MM-dd")' />
                <input type="hidden" name="IsReorder" value="true" />
                <input type="hidden" name="Items[0].ProductId" value="@p.ProductId" />
                <input type="hidden" name="Items[0].ProductName" value="@p.ProductName" />
                <input type="hidden" name="Items[0].Brand" value="@p.Brand" />
                <input type="hidden" name="Items[0].Category" value="@p.Category?.CategoryName" />
                <input type="hidden" name="Items[0].ReorderLevel" value="@p.ReorderLevel" />
                <input type="hidden" name="Items[0].CurrentStock" value="@p.QuantityOnHand" />
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Product</label>
                        <input class="form-control" readonly value="@p.ProductName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Brand</label>
                        <input class="form-control" readonly value="@p.Brand" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <input class="form-control" readonly value="@p.Category?.CategoryName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Supplier</label>
                        <input class="form-control" readonly value="@p.Supplier?.CompanyName" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Current Stock</label>
                        <input class="form-control" readonly value="@p.QuantityOnHand" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Reorder Level</label>
                        <input class="form-control" readonly value="@p.ReorderLevel" />
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Quantity</label>
                        <input type="number" name="Items[0].Quantity" class="form-control" min="1" required />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-app-primary"><i class="bi bi-plus-lg"></i> Create Purchase Order</button>
                    <a asp-action="Search" asp-controller="Sales" class="btn btn-app-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="cpo-page row">

        <div class="col-12 col-lg-8 d-flex">
            <div class="card cpo-product-card w-100 mb-0">
                <div class="card-header cpo-card-header">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Products</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive cpo-table-scroll">
                        <table class="table table-striped align-middle mb-0 cpo-product-table">
                            <thead>
                                <tr>
                                    <th style="width:28%" class="text-start">Name</th>
                                    <th style="width:14%" class="text-start">Brand</th>
                                    <th style="width:16%" class="text-start">Category</th>
                                    <th style="width:12%" class="text-end">Price</th>
                                    <th style="width:10%" class="text-center">Stock</th>
                                    <th style="width:20%" class="text-center">How Many to Buy</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Products.Items)
                                {
                                    <tr class="align-middle">
                                        <td>@p.ProductName</td>
                                        <td>@p.Brand</td>
                                        <td>@p.Category?.CategoryName</td>
                                        <td class="text-end">@p.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                                        <td class="text-center">
                                            @p.QuantityOnHand
                                        </td>
                                        <td>
                                            <form asp-action="AddToCart" method="post" class="d-inline" onsubmit="this.querySelector('button[type=submit]').disabled=true;">
                                                <input type="hidden" name="productId" value="@p.ProductId" />
                                                <input type="hidden" name="query" value="@Model.SearchQuery" />
                                                <div class="cpo-product-actions">
                                                    @{ var cartItem = cart.Items.FirstOrDefault(i => i.ProductId == p.ProductId);
                                                       var inputValue = cartItem?.Quantity ?? 1; }
                                                    <input type="number" name="quantity" min="1" max="@p.QuantityOnHand" value="@inputValue" aria-label="Quantity to buy for @p.ProductName" class="form-control form-control-sm cpo-qty-input" />
                                                    <button type="submit" class="btn btn-primary btn-sm cpo-add-btn">Add</button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 d-flex">
            <div class="card cpo-cart-card w-100 mb-0">
                <div class="card-header cpo-card-header">
                    <h5 class="mb-0"><i class="bi bi-cart3 me-2"></i>Current Cart</h5>
                    <span class="badge bg-primary">@cart.Items.Count @(cart.Items.Count == 1 ? "item" : "items")</span>
                </div>
                <div class="card-body cpo-cart-body p-0">
                    @if (!cart.Items.Any())
                    {
                        <div class="cpo-cart-empty">
                            <i class="bi bi-cart-x" aria-hidden="true"></i>
                            <p class="cpo-cart-empty-title">Your cart is empty.</p>
                            <p class="cpo-cart-empty-sub">Add products from the list to start a purchase order.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive cpo-table-scroll">
                            <table class="table table-striped align-middle mb-0 cpo-cart-table">
                                <colgroup>
                                    <col style="width:40%" />
                                    <col style="width:18%" />
                                    <col style="width:24%" />
                                    <col style="width:18%" />
                                </colgroup>
                                <thead>
                                    <tr><th class="text-start">Product</th><th class="text-end">Price</th><th class="text-center">Qty</th><th class="text-end">Subtotal</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in cart.Items)
                                    {
                                        <tr>
                                            <td class="cpo-cart-product-cell">@item.ProductName</td>
                                            <td class="text-end">@item.UnitPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                                            <td class="text-center cart-quantity-controls">
                                                <div class="cpo-cart-qty-group">
                                                    <form asp-action="DecreaseQuantity" method="post" class="d-inline">
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <input type="hidden" name="query" value="@Model.SearchQuery" />
                                                        <button type="submit" class="btn btn-icon btn-minus" aria-label="Decrease quantity"><i class="bi bi-dash"></i></button>
                                                    </form>
                                                    <span class="cpo-cart-qty-value">@item.Quantity</span>
                                                    <form asp-action="IncreaseQuantity" method="post" class="d-inline">
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <input type="hidden" name="query" value="@Model.SearchQuery" />
                                                        <button type="submit" class="btn btn-icon btn-plus" aria-label="Increase quantity"><i class="bi bi-plus"></i></button>
                                                    </form>
                                                    <form asp-action="RemoveItem" method="post" class="d-inline cpo-cart-remove-form">
                                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                                        <input type="hidden" name="query" value="@Model.SearchQuery" />
                                                        <button type="submit" class="btn btn-icon btn-delete" aria-label="Remove item"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                            <td class="text-end">@item.Subtotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="cpo-cart-footer">
                            <div class="cpo-total">TOTAL: @cart.Items.Sum(i => i.Subtotal).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</div>
                            <form asp-action="SaveSerialNumbers" method="post">
                                <input type="hidden" name="query" value="@Model.SearchQuery" />
                                @Html.AntiForgeryToken()
                                @foreach (var item in cart.Items.Where(i => i.IsSerialized))
                                {
                                    <div class="cpo-serial-section">
                                        <label>Serial Numbers for @item.ProductName (Qty: @item.Quantity)</label>
                                        @for (int i = 0; i < item.Quantity; i++)
                                        {
                                            var existing = cart.SerialNumbers != null && cart.SerialNumbers.TryGetValue(item.ProductId, out var list) && list.Count > i ? list[i] : "";
                                            <input type="text" name="SerialNumbers[@item.ProductId][@i]" value="@existing" aria-label="Serial number @(i + 1) of @item.Quantity for @item.ProductName" class="form-control cpo-serial-input" />
                                        }
                                    </div>
                                }
                                <button type="submit" class="btn btn-primary w-100 mt-3">Proceed to Confirm</button>
                            </form>
                            <a asp-action="Search" class="btn btn-app-secondary w-100 mt-2">Back to Purchase Order</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
