@model KaijensonIventory_SalesMotorShopWeb.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Cart";
}
<div class="page-header mb-3">
    <div>
        <h1>Cart</h1>
        <p>Review items in the purchase order.</p>
    </div>
    
</div>
@if (!Model.Items.Any())
{
    <p>Your cart is empty.</p>
    <a asp-action="Search" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <div class="cart-table-wrapper"><div class="table-responsive"><table class="table table-bordered align-middle cart-table">
        <thead>
            <tr><th>Product</th><th class="text-end">Price</th><th class="text-center">Quantity</th><th class="text-end">Subtotal</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td class="text-end">@item.UnitPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                <td class="text-center cart-quantity-controls">
<div class="d-flex align-items-center gap-2 cart-quantity-controls">
                                <form asp-action="DecreaseQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-icon btn-minus" aria-label="Decrease quantity"><i class="bi bi-dash"></i></button>
                                </form>
                                <span class="mx-2">@item.Quantity</span>
                                <form asp-action="IncreaseQuantity" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-icon btn-plus" aria-label="Increase quantity"><i class="bi bi-plus"></i></button>
                                </form>
                                <form asp-action="RemoveItem" method="post" class="d-inline ms-2">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-icon btn-delete" aria-label="Remove item"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
    </td>
                <td class="text-end">@item.Subtotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
            </tr>
        }
        </tbody>
    </table></div></div>
<div class="mt-3 fw-bold text-end mb-2">TOTAL: @Model.Items.Sum(i => i.Subtotal).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</div>
<div class="mt-2">
<form asp-action="SaveSerialNumbers" method="post">
    @Html.AntiForgeryToken()
    @foreach (var item in Model.Items.Where(i => i.IsSerialized))
    {
        <div class="mt-3">
            <label>Serial Numbers for @item.ProductName (Qty: @item.Quantity)</label>
            @for (int i = 0; i < item.Quantity; i++)
            {
                var existing = Model.SerialNumbers != null && Model.SerialNumbers.TryGetValue(item.ProductId, out var list) && list.Count > i ? list[i] : "";
                <input type="text" name="SerialNumbers[@item.ProductId][@i]" value="@existing" class="form-control mb-1" />
            }
        </div>
    }
    <button type="submit" class="btn btn-primary me-2 mt-2">Proceed to Confirm</button>
</form>
<a asp-action="Search" class="btn btn-app-secondary">Back to Purchase Order</a>
</div>
}
