@model KaijensonIventory_SalesMotorShopWeb.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Cart";
}
<h2>Cart</h2>
<a asp-action="Search" class="btn btn-outline-primary me-2"><i class="bi bi-house"></i> Home</a>
@if (!Model.Items.Any())
{
    <p>Your cart is empty.</p>
    <a asp-action="Search" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <div class="table-responsive"><table class="table table-bordered align-middle">
        <thead>
            <tr><th>Product</th><th class="text-end">Price</th><th class="text-center">Quantity</th><th class="text-end">Subtotal</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td class="text-end">@item.UnitPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
                <td class="text-center">
        <form asp-action="DecreaseQuantity" method="post" class="d-inline">
            <input type="hidden" name="productId" value="@item.ProductId" />
            <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Decrease quantity"><i class="bi bi-dash"></i></button>
        </form>
        <span class="mx-2">@item.Quantity</span>
        <form asp-action="IncreaseQuantity" method="post" class="d-inline">
            <input type="hidden" name="productId" value="@item.ProductId" />
            <button type="submit" class="btn btn-outline-success btn-sm" aria-label="Increase quantity"><i class="bi bi-plus"></i></button>
        </form>
        <form asp-action="RemoveItem" method="post" class="d-inline ms-2">
            <input type="hidden" name="productId" value="@item.ProductId" />
            <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Remove item"><i class="bi bi-trash"></i></button>
        </form>
    </td>
                <td class="text-end">@item.Subtotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</td>
            </tr>
        }
        </tbody>
    </table></div>
<div class="mt-3 fw-bold text-end">TOTAL: @Model.Items.Sum(i => i.Subtotal).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</div>
    <a asp-action="Confirm" class="btn btn-primary me-2">Proceed to Confirm</a>
    <a asp-action="Search" class="btn btn-outline-secondary">Add More</a>
}
