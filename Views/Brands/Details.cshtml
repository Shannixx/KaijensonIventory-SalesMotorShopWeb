@model KaijensonIventory_SalesMotorShopWeb.Models.Brand
@{ ViewData["Title"] = "Brand Details"; }

<div class="page-header">
    <div>
        <h1>Brand Details</h1>
        <p>View brand information.</p>
    </div>
</div>

<div class="card" style="max-width:600px; margin:0 auto;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.BrandId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.BrandId)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.BrandName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.BrandName)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CountryOrigin)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CountryOrigin)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Status)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.Status)</dd>
        </dl>

        <div class="d-flex gap-2">

            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
        </div>
    </div>
</div>
