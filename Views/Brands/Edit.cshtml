@model KaijensonIventory_SalesMotorShopWeb.ViewModels.BrandFormViewModel
@{ ViewData["Title"] = "Edit Brand"; }

<div class="page-header">
    <div>
        <h1>Edit Brand</h1>
        <p>Update brand details.</p>
    </div>
</div>

<div class="card form-card-narrow">
    <div class="card-body">
        <form asp-action="Edit">
            <input asp-for="BrandId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="BrandName" class="form-label"></label>
                <input asp-for="BrandName" class="form-control" placeholder="e.g. Honda" required />
                <span asp-validation-for="BrandName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CountryOrigin" class="form-label"></label>
                <input asp-for="CountryOrigin" class="form-control" placeholder="e.g. Japan" required />
                <span asp-validation-for="CountryOrigin" class="text-danger"></span>
            </div>



                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter brand description (optional)"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SupplierId" class="form-label"></label>
                    <select asp-for="SupplierId" class="form-select" asp-items="Model.Suppliers">
                        <option value="">Select Supplier</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Brand ID</label>
                    <p class="form-control-plaintext">@Model.BrandId</p>
                </div>
                <div class="mb-3">
                    <label class="form-label">Created By</label>
                    <p class="form-control-plaintext">@Model.CreatedByName</p>
                </div>
                <div class="mb-3">
                    <label class="form-label">Date Created</label>
                    <p class="form-control-plaintext">@Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                </div>

                <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Save Changes</span>
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
