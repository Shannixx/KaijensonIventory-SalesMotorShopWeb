@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Brand>
@{ ViewData["Title"] = "Brands"; }

<div class="page-header">
    <div>
        <h1>Brands</h1>
        <p>Manage product brands.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">Add Brand</a>
        @if (ViewBag.CanDelete == true)
        {
            <a asp-action="Index" asp-route-archived="@(ViewBag.ShowArchived == true ? "false" : "true")" class="btn btn-outline-secondary">@(ViewBag.ShowArchived == true ? "Active Brands" : "Archived")</a>
        }
    </div>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Brands",
        ActionName = "Index",
        QueryParameterName = "searchString",
        QueryValue = ViewData["CurrentFilter"] as string,
        Placeholder = "Search by name or country...",
        AriaLabel = "Search brands",
        InputId = "searchBrands",
        ClearActionName = "Index",
        ClearControllerName = "Brands"
    };
}
<partial name="_SearchToolbar" model="searchModel" />

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="text-center" style="width:15%">ID</th>
                        <th class="text-center" style="width:60%">Brand Name</th>

                        <th class="actions-column text-center" style="width:25%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var counts = ViewData["ProductCounts"] as Dictionary<string, int>;
                        var prodCount = counts?.GetValueOrDefault(item.BrandName, 0) ?? 0;
                        var isInUse = prodCount > 0;
                        <tr>
                            <td class="text-center">@item.BrandId</td>
                            <td class="text-center">@item.BrandName</td>
                            

                            
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.BrandId" asp-route-archived="@(ViewBag.ShowArchived == true ? "true" : "false")" class="btn btn-icon btn-icon-view" title="View brand" aria-label="View brand @item.BrandName"><i class="bi bi-eye"></i></a>
                                    @if (ViewBag.ShowArchived != true)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.BrandId" class="btn btn-icon btn-icon-edit" title="Edit brand" aria-label="Edit brand @item.BrandName"><i class="bi bi-pencil"></i></a>
                                    }
                                    @if (ViewBag.CanDelete == true)
                                    {
                                        @if (ViewBag.ShowArchived == true)
                                        {
                                            <form asp-action="Restore" asp-route-id="@item.BrandId" method="post" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-icon" title="Restore brand" aria-label="Restore @item.BrandName"><i class="bi bi-arrow-counterclockwise"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.BrandId" method="post" id="delete-brand-@item.BrandId" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-brand-@item.BrandId" data-delete-record-name="@item.BrandName" data-delete-entity-name="brand" title="Archive brand" aria-label="Archive brand @item.BrandName"><i class="bi bi-archive"></i></button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No brands found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />

