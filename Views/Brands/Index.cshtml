@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Brand>
@{ ViewData["Title"] = "Brands"; }

<div class="page-header">
    <div>
        <h1>Brands</h1>
        <p>Manage product brands.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Brand</a>
</div>

<div class="search-toolbar-card">
    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label class="form-label small">Search</label>
            <input type="text" name="searchString" class="form-control" placeholder="Search by name or country..." value="@ViewData["CurrentFilter"]" style="min-width:200px;" />
        </div>
        <div>
            <label class="form-label small">Status</label>
            <select name="statusFilter" class="form-select" style="min-width:140px;">
                <option value="">All</option>
                <option value="Active" selected="@(ViewData["StatusFilter"]?.ToString() == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewData["StatusFilter"]?.ToString() == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn-search"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn-clear"><i class="bi bi-x-lg"></i> Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Brand Name</th>
                        <th>Country</th>
                        <th>Status</th>
                        <th>Products</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var counts = ViewData["ProductCounts"] as Dictionary<string, int>;
                        var prodCount = counts?.GetValueOrDefault(item.BrandName, 0) ?? 0;
                        var isInUse = prodCount > 0;
                        <tr>
                            <td>@item.BrandId</td>
                            <td>@item.BrandName</td>
                            <td>@item.CountryOrigin</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@prodCount</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.BrandId" class="btn btn-icon btn-icon-view" title="View brand" aria-label="View brand @item.BrandName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.BrandId" class="btn btn-icon btn-icon-edit" title="Edit brand" aria-label="Edit brand @item.BrandName"><i class="bi bi-pencil"></i></a>
                                    @if (ViewBag.CanDelete == true)
                                    {
                                        @if (isInUse)
                                        {
                                            <span class="d-inline-flex" tabindex="0" title="This brand cannot be deleted until its products are reassigned." aria-label="Cannot delete brand @item.BrandName because it is in use">
                                                <button type="button" class="btn btn-icon btn-icon-delete" disabled aria-hidden="true" tabindex="-1"><i class="bi bi-trash"></i></button>
                                            </span>
                                        }
                                        else
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.BrandId" method="post" id="delete-brand-@item.BrandId" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-brand-@item.BrandId" data-delete-record-name="@item.BrandName" data-delete-entity-name="brand" title="Delete brand" aria-label="Delete brand @item.BrandName"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No brands found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />

