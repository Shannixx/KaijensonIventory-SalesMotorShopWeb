@model KaijensonIventory_SalesMotorShopWeb.ViewModels.BrandFormViewModel
@{ ViewData["Title"] = "Create Brand"; }

<div class="page-header">
    <div>
        <h1>Create Brand</h1>
        <p>Add a new product brand.</p>
    </div>
</div>

<div class="card form-card-narrow">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="BrandName" class="form-label"></label>
                <input asp-for="BrandName" class="form-control" placeholder="e.g. Honda" required />
                <span asp-validation-for="BrandName" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    
                    <span>Create Brand</span>
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
