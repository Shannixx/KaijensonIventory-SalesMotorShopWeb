@model KaijensonIventory_SalesMotorShopWeb.ViewModels.ReportsPageViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Reports";
}
<div class="page-header">
    <div>
        <h1>Reports</h1>
        <p>View inventory, sales, stock movement, and serial-number information.</p>
    </div>
</div>

<div class="card report-filter-card">
    <div class="card-body">
        <form method="get" class="report-filter-grid">
            <div class="report-filter-field">
                <label asp-for="Filter.StartDate" class="form-label">Start Date</label>
                <input asp-for="Filter.StartDate" class="form-control" type="date" />
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.EndDate" class="form-label">End Date</label>
                <input asp-for="Filter.EndDate" class="form-control" type="date" />
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.ProductId" class="form-label">Product</label>
                <select asp-for="Filter.ProductId" class="form-select" asp-items='@(new SelectList(ViewBag.Products, "ProductId", "ProductName", Model.Filter.ProductId))'>
                    <option value="">All Products</option>
                </select>
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.CategoryId" class="form-label">Category</label>
                <select asp-for="Filter.CategoryId" class="form-select" asp-items='@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName", Model.Filter.CategoryId))'>
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.SerialNumber" class="form-label">Serial</label>
                <input asp-for="Filter.SerialNumber" class="form-control" type="text" placeholder="Serial number" />
            </div>
            <div class="report-filter-field d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Generate</button>
            </div>
        </form>
        <div class="report-export-buttons mb-3 mt-2">
            <a asp-action="ExportCsv" asp-route-StartDate="@(Model.Filter.StartDate.ToString("yyyy-MM-dd"))" asp-route-EndDate="@(Model.Filter.EndDate.ToString("yyyy-MM-dd"))" asp-route-ProductId="@Model.Filter.ProductId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-SerialNumber="@Model.Filter.SerialNumber" class="btn btn-outline-primary me-2">Export CSV</a>
            <a asp-action="ExportPdf" asp-route-StartDate="@(Model.Filter.StartDate.ToString("yyyy-MM-dd"))" asp-route-EndDate="@(Model.Filter.EndDate.ToString("yyyy-MM-dd"))" asp-route-ProductId="@Model.Filter.ProductId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-SerialNumber="@Model.Filter.SerialNumber" class="btn btn-outline-secondary">Export PDF</a>
        </div>
    </div>
</div>


<div class="dashboard-metrics">
    <div class="metric-card"><div class="metric-info"><p class="metric-label">Total Revenue</p><h3 class="metric-value">@Model.RevenueReport.TotalRevenue.ToString("C")</h3></div></div>
    <div class="metric-card"><div class="metric-info"><p class="metric-label">Total Qty Sold</p><h3 class="metric-value">@Model.SalesPerformanceReport.TotalQuantitySold</h3></div></div>
    <div class="metric-card"><div class="metric-info"><p class="metric-label">Transactions</p><h3 class="metric-value">@Model.SalesPerformanceReport.TransactionCount</h3></div></div>
    <div class="metric-card"><div class="metric-info"><p class="metric-label">Inventory Value</p><h3 class="metric-value">@Model.TotalInventoryValue.ToString("C")</h3></div></div>
    <div class="metric-card"><div class="metric-info"><p class="metric-label">Low Stock Items</p><h3 class="metric-value">@Model.LowStockItemCount</h3></div></div>
</div>
<hr />
<div class="card report-section-card"><div class="card-header">Current Stock</div><div class="card-body">
<div class="table-responsive"><table class="table table-sm table-striped">
    <thead><tr><th>Product</th><th>Category</th><th>Qty On Hand</th><th>Status</th></tr></thead>
    <tbody>
    @if (Model.InventoryReport.Items != null && Model.InventoryReport.Items.Any())
    {
        foreach (var item in Model.InventoryReport.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.QuantityOnHand</td>
                <td>@item.StockStatus</td>
                
            </tr>
        }
    }
    else
    {
        <tr><td colspan="4" class="text-center">No records found for the selected filters.</td></tr>
    }
    </tbody>
</table></div></div></div>
<div class="card report-section-card"><div class="card-header">Sales Performance</div><div class="card-body">
<div class="table-responsive"><table class="table table-sm table-striped">
    <thead><tr><th>Transactions</th><th>Total Qty Sold</th><th>Total Revenue</th></tr></thead>
    <tbody>
        <tr>
            <td>@Model.SalesPerformanceReport.TransactionCount</td>
            <td>@Model.SalesPerformanceReport.TotalQuantitySold</td>
            <td>@Model.SalesPerformanceReport.TotalRevenue.ToString("C")</td>
        </tr>
    </tbody>
</table></div></div></div>
<div class="card report-section-card"><div class="card-header">Most Sold Products</div><div class="card-body">
<div class="table-responsive"><table class="table table-sm table-striped">
    <thead><tr><th>Product</th><th>Qty Sold</th><th>Unit Price</th><th>Revenue</th></tr></thead>
    <tbody>
@if (Model.MostSoldProducts != null && Model.MostSoldProducts.Any())
    {
        foreach (var p in Model.MostSoldProducts)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.QuantitySold</td>
                <td>@p.UnitPrice.ToString("C")</td>
                <td>@p.Revenue.ToString("C")</td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="4" class="text-center">No records found for the selected filters.</td></tr>
    }
    </tbody>
</table></div></div></div>
<div class="card report-section-card"><div class="card-header">Stock Movements</div><div class="card-body">
<div class="table-responsive"><table class="table table-sm table-striped">
    <thead><tr><th>Date</th><th>Product</th><th>Type</th><th>Qty</th><th>Reference</th></tr></thead>
    <tbody>
    @if (Model.StockMovements != null && Model.StockMovements.Any())
    {
        foreach (var m in Model.StockMovements)
        {
            <tr>
                <td>@m.Date.ToShortDateString()</td>
                <td>@m.ProductName</td>
                <td>@m.MovementType</td>
                <td>@m.Quantity</td>
                <td>@m.Reference</td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="5" class="text-center">No records found for the selected filters.</td></tr>
    }
    </tbody>
</table></div></div></div>
<div class="card report-section-card"><div class="card-header">Serial Numbers</div><div class="card-body">
<div class="table-responsive"><table class="table table-sm table-striped">
    <thead><tr><th>Serial</th><th>Product</th><th>Status</th><th>Sale Id</th><th>Sale Date</th></tr></thead>
    <tbody>
    @if (Model.SerialNumberReport != null && Model.SerialNumberReport.Any())
    {
        foreach (var s in Model.SerialNumberReport)
        {
            <tr>
                <td>@s.SerialNumber</td>
                <td>@s.ProductName</td>
                <td>@s.Status</td>
                <td>@(s.SaleId?.ToString() ?? "-")</td>
                <td>@(s.SaleDate?.ToShortDateString() ?? "-")</td>
            </tr>
        }
    }
    else
    {
        <tr><td colspan="5" class="text-center">No records found for the selected filters.</td></tr>
    }
    </tbody>
</table></div></div></div>

<!-- Revenue Trend -->
<div class="card report-section-card"><div class="card-header">Revenue Trend</div><div class="card-body"><canvas id="revenueTrendChart" height="100"></canvas></div></div>
<!-- Sales By Category -->
<div class="card report-section-card"><div class="card-header">Sales By Category</div><div class="card-body"><canvas id="salesByCategoryChart" height="100"></canvas></div></div>
<div class="card report-section-card"><div class="card-header">Sales By Category</div><div class="card-body"><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Category</th><th>Revenue</th><th>Units Sold</th></tr></thead><tbody>@if (Model.SalesByCategory != null && Model.SalesByCategory.Any()) { foreach (var c in Model.SalesByCategory) { <tr><td>@c.CategoryName</td><td>@c.Revenue.ToString("C")</td><td>@c.UnitsSold</td></tr> } } else { <tr><td colspan="3" class="text-center">No records found for the selected filters.</td></tr> }</tbody></table></div></div></div>
<!-- Low Stock Alerts -->
<div class="card report-section-card"><div class="card-header">Low Stock Alerts</div><div class="card-body"><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Product</th><th>Qty On Hand</th><th>Reorder Level</th><th>Status</th></tr></thead><tbody>@if (Model.LowStockAlerts != null && Model.LowStockAlerts.Any()) { foreach (var a in Model.LowStockAlerts) { <tr><td>@a.ProductName</td><td>@a.QuantityOnHand</td><td>@a.ReorderLevel</td><td>@a.StockStatus</td></tr> } } else { <tr><td colspan="4" class="text-center">No low stock alerts.</td></tr> }</tbody></table></div></div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueTrendChart').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.Period.ToString("yyyy-MM-dd")))),
                datasets: [
                    {
                        label: 'Revenue',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.Revenue))),
                        borderColor: '#007bff',
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    x: { display: true, title: { display: true, text: 'Date' } },
                    y: { display: true, title: { display: true, text: 'Amount' } }
                }
            }
        });
    </script>
    <script>
        const catCtx = document.getElementById('salesByCategoryChart').getContext('2d');
        const catChart = new Chart(catCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByCategory.Select(c => c.CategoryName)))
                datasets: [{
                    label: 'Revenue by Category',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesByCategory.Select(c => c.Revenue))),
                    backgroundColor: ['#007bff', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#20c997']
                }]
            },
            options: {
                responsive: true
            }
        });
    </script>
}
