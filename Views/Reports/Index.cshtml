@model KaijensonIventory_SalesMotorShopWeb.ViewModels.ReportsPageViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization
@{
    ViewData["Title"] = "Reports";
    string currentUser = Context.Session.GetString("StaffName") ?? "Unknown";
    string generatedOn = DateTime.Now.ToString("MMMM dd, yyyy h:mm tt");
    var activeReport = ViewBag.ActiveReport as string;
    string StatusClass(string s) => s switch
    {
        "Available" => "kx-status-available",
        "Low Stock" => "kx-status-low",
        _ => "kx-status-out"
    };
}
<div class="kaijenson-reports">

    @* ─── Page Header ─── *@
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 kx-page-header">
        <div>
            <h1>Reports</h1>
            <p>Sales and Inventory Management Reports</p>
        </div>
        <a href="#" id="kxBackBtn" class="kx-back-link kx-hidden"><i class="bi bi-arrow-left me-1"></i>Back to Reports</a>
    </div>

    @* ─── Landing: Report Categories (K_Presso-style cards) ─── *@
    <div id="reportsLanding">
        <div class="row g-3 g-md-4">
            <div class="col-12 col-md-6">
                <a href="#salesTab" class="kx-report-card kx-report-link" data-target="salesTab">
                    <div class="kx-report-icon"><i class="bi bi-receipt"></i></div>
                    <div class="kx-report-body">
                        <h2 class="kx-report-card-title">Sales Report</h2>
                        <p class="kx-report-card-desc">Sales performance, revenue, transactions and most-sold products.</p>
                    </div>
                </a>
            </div>
            <div class="col-12 col-md-6">
                <a href="#inventoryTab" class="kx-report-card kx-report-link" data-target="inventoryTab">
                    <div class="kx-report-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="kx-report-body">
                        <h2 class="kx-report-card-title">Inventory Report</h2>
                        <p class="kx-report-card-desc">Current stock, inventory value, low stock and reorder information.</p>
                    </div>
                </a>
            </div>
        </div>
    </div>

    @* ─── Shared Filter Bar (existing filters, restyled) ─── *@
    <div id="reportsFilterArea" class="kx-filter-bar kx-hidden">
        <form method="get" class="report-filter-grid">
            <input type="hidden" name="report" id="activeReport" value="@activeReport" />
            <div class="report-filter-field">
                <label asp-for="Filter.StartDate" class="form-label">Start Date</label>
                <input asp-for="Filter.StartDate" class="form-control" type="date" />
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.EndDate" class="form-label">End Date</label>
                <input asp-for="Filter.EndDate" class="form-control" type="date" />
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.ProductId" class="form-label">Product</label>
                <select asp-for="Filter.ProductId" class="form-select" asp-items='@(new SelectList(ViewBag.Products, "ProductId", "ProductName", Model.Filter.ProductId))'>
                    <option value="">All Products</option>
                </select>
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.CategoryId" class="form-label">Category</label>
                <select asp-for="Filter.CategoryId" class="form-select" asp-items='@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName", Model.Filter.CategoryId))'>
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="report-filter-field">
                <label asp-for="Filter.SerialNumber" class="form-label">Serial</label>
                <input asp-for="Filter.SerialNumber" class="form-control" type="text" placeholder="Serial number" />
            </div>
            <div class="report-filter-field d-flex align-items-end">
                <button type="submit" class="btn kx-btn-generate w-100"><i class="bi bi-funnel me-1"></i>Generate</button>
            </div>
        </form>
        <div class="quick-date-range kx-quick-dates mt-3 d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm" data-range="7">Last 7 Days</button>
            <button type="button" class="btn btn-sm" data-range="30">Last 30 Days</button>
        </div>
        <hr class="my-3" style="border-color: var(--border-color); opacity: .5;" />
        <div class="report-export-buttons d-flex flex-wrap gap-2">
            <a asp-action="ExportCsv" asp-route-StartDate="@(Model.Filter.StartDate.ToString("yyyy-MM-dd"))" asp-route-EndDate="@(Model.Filter.EndDate.ToString("yyyy-MM-dd"))" asp-route-ProductId="@Model.Filter.ProductId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-SerialNumber="@Model.Filter.SerialNumber" class="btn kx-export-btn"><i class="bi bi-filetype-csv me-1"></i>Export CSV</a>
            <a id="pdfSalesBtn" asp-action="ExportSalesPdf" asp-route-StartDate="@(Model.Filter.StartDate.ToString("yyyy-MM-dd"))" asp-route-EndDate="@(Model.Filter.EndDate.ToString("yyyy-MM-dd"))" asp-route-ProductId="@Model.Filter.ProductId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-SerialNumber="@Model.Filter.SerialNumber" class="btn kx-export-btn @(activeReport == "Sales" ? "" : "kx-hidden")"><i class="bi bi-filetype-pdf me-1"></i>Export PDF</a>
            <a id="pdfInventoryBtn" asp-action="ExportInventoryPdf" asp-route-StartDate="@(Model.Filter.StartDate.ToString("yyyy-MM-dd"))" asp-route-EndDate="@(Model.Filter.EndDate.ToString("yyyy-MM-dd"))" asp-route-ProductId="@Model.Filter.ProductId" asp-route-CategoryId="@Model.Filter.CategoryId" asp-route-SerialNumber="@Model.Filter.SerialNumber" class="btn kx-export-btn @(activeReport == "Inventory" ? "" : "kx-hidden")"><i class="bi bi-filetype-pdf me-1"></i>Export PDF</a>
        </div>
    </div>

    <div class="tab-content">
        @* ═══════════ SALES REPORT SECTION ═══════════ *@
        <div class="tab-pane kx-pane kx-hidden" id="salesTab">
            @* Report header + metadata *@
            <div class="kx-detail-header">
                <h2 class="kx-detail-title">Sales Report</h2>
                <div class="kx-meta">
                    <span class="kx-meta-item"><strong>Date Range:</strong> @Model.Filter.StartDate.ToString("MMMM dd, yyyy") &ndash; @Model.Filter.EndDate.ToString("MMMM dd, yyyy")</span>
                    <span class="kx-meta-item"><strong>Generated:</strong> @generatedOn</span>
                    <span class="kx-meta-item"><strong>Current User:</strong> @currentUser</span>
                </div>
            </div>

            @* Metric cards (existing metrics, Kaijenson stat-card style) *@
            <div class="kx-metrics dashboard-metrics">
                <div class="kx-metric metric-card"><div class="kx-metric-icon"><i class="bi bi-cash-stack"></i></div><div class="metric-info"><p class="kx-metric-label metric-label">Total Revenue</p><h3 class="kx-metric-value metric-value">@Model.RevenueReport.TotalRevenue.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</h3></div></div>
                <div class="kx-metric metric-card"><div class="kx-metric-icon"><i class="bi bi-cart-check"></i></div><div class="metric-info"><p class="kx-metric-label metric-label">Total Qty Sold</p><h3 class="kx-metric-value metric-value">@Model.SalesPerformanceReport.TotalQuantitySold</h3></div></div>
                <div class="kx-metric metric-card"><div class="kx-metric-icon"><i class="bi bi-receipt"></i></div><div class="metric-info"><p class="kx-metric-label metric-label">Transactions</p><h3 class="kx-metric-value metric-value">@Model.SalesPerformanceReport.TransactionCount</h3></div></div>
                <div class="kx-metric metric-card"><div class="kx-metric-icon"><i class="bi bi-exclamation-triangle"></i></div><div class="metric-info"><p class="kx-metric-label metric-label">Low Stock Items</p><h3 class="kx-metric-value metric-value">@Model.LowStockItemCount</h3></div></div>
            </div>

            @* Revenue Trend (existing chart, coffee palette) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-graph-up"></i><h5>Revenue Trend</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-chart-box">
                        <canvas id="revenueTrendChart"></canvas>
                    </div>
                </div>
            </div>

            @* Sales Performance (existing data) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-bar-chart"></i><h5>Sales Performance</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Transactions</th><th>Total Qty Sold</th><th>Total Revenue</th></tr></thead>
                        <tbody>
                            <tr>
                                <td>@Model.SalesPerformanceReport.TransactionCount</td>
                                <td>@Model.SalesPerformanceReport.TotalQuantitySold</td>
                                <td class="text-end">@Model.SalesPerformanceReport.TotalRevenue.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                            </tr>
                        </tbody>
                    </table></div>
                </div>
            </div>

            @* Most Sold Products (existing data + empty state) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-trophy"></i><h5>Most Sold Products</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Product</th><th class="text-end">Qty Sold</th><th class="text-end">Unit Price</th><th class="text-end">Revenue</th></tr></thead>
                        <tbody>
                        @if (Model.MostSoldProducts != null && Model.MostSoldProducts.Any())
                        {
                            foreach (var p in Model.MostSoldProducts)
                            {
                                <tr>
                                    <td>@p.ProductName</td>
                                    <td class="text-end">@p.QuantitySold</td>
                                    <td class="text-end">@p.UnitPrice.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                                    <td class="text-end">@p.Revenue.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="kx-empty">No records found for the selected filters.</td></tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            </div>

            @* Sales By Category (existing chart + table) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-pie-chart"></i><h5>Sales By Category</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-chart-box mb-4">
                        <canvas id="salesByCategoryChart"></canvas>
                    </div>
                    <div class="kx-table-wrap table-responsive">
                        <table class="table kx-table table-sm table-bordered mb-0">
                            <thead><tr><th>Category</th><th class="text-end">Revenue</th><th class="text-end">Units Sold</th></tr></thead>
                            <tbody>
                            @if (Model.SalesByCategory != null && Model.SalesByCategory.Any())
                            {
                                foreach (var c in Model.SalesByCategory)
                                {
                                    <tr>
                                        <td>@c.CategoryName</td>
                                        <td class="text-end">@c.Revenue.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                                        <td class="text-end">@c.UnitsSold</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3" class="kx-empty">No records found for the selected filters.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* Service Transactions (new section) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-tools"></i><h5>Service Transactions</h5></div>
                <div class="kx-section-body card-body">
                    <div class="mb-3">
                        <input type="text" id="serviceSearch" class="form-control kx-search-input" placeholder="Search service name, ID, customer..." />
                    </div>
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Service Name</th><th>Service ID</th><th>Job ID</th><th>Customer</th><th class="text-end">Amount Paid</th><th class="text-end">Change</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                        @if (Model.ServiceTransactions != null && Model.ServiceTransactions.Any())
                        {
                            foreach (var st in Model.ServiceTransactions)
                            {
                                <tr>
                                    <td>@st.ServiceName</td>
                                    <td>@st.ServiceId</td>
                                    <td>@st.ServiceJobNumber</td>
                                    <td>@st.CustomerName</td>
                                    <td class="text-end">@st.AmountPaid.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                                    <td class="text-end">@st.ChangeAmount.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                                    <td>@st.ServiceDate.ToString("yyyy-MM-dd")</td>
                                    <td>@st.PaymentStatus</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="kx-empty">No service transactions found for the selected filters.</td></tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            </div>
            @* ═══════════ INVENTORY REPORT SECTION ═══════════ *@
        <div class="tab-pane kx-pane kx-hidden" id="inventoryTab">
            @* Formal centered report header + metadata *@
            <div class="kx-detail-header text-center">
                <p class="kx-detail-shop mb-1">Kaijenson Motor Shop</p>
                <h2 class="kx-detail-title">Inventory Report</h2>
                <div class="kx-meta justify-content-center">
                    <span class="kx-meta-item"><strong>As of Date:</strong> @Model.Filter.EndDate.ToString("MMMM dd, yyyy")</span>
                    <span class="kx-meta-item"><strong>Generated:</strong> @generatedOn</span>
                    <span class="kx-meta-item"><strong>Current User:</strong> @currentUser</span>
                </div>
            </div>

            @* Current Stock (existing data, search behavior unchanged) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-boxes"></i><h5>Current Stock</h5></div>
                <div class="kx-section-body card-body">
                    <div class="mb-3">
                        <input type="text" id="inventorySearch" class="form-control kx-search-input" placeholder="Search product or category..." />
                    </div>
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Product</th><th>Category</th><th class="text-end">Qty On Hand</th><th>Status</th></tr></thead>
                        <tbody>
                        @if (Model.InventoryReport.Items != null && Model.InventoryReport.Items.Any())
                        {
                            foreach (var item in Model.InventoryReport.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.CategoryName</td>
                                    <td class="text-end">@item.QuantityOnHand</td>
                                    <td><span class="kx-badge @StatusClass(item.StockStatus)">@item.StockStatus</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="kx-empty">No records found for the selected filters.</td></tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            </div>

            @* Low Stock Alerts (existing query, thresholds unchanged: 0 = Out of Stock, 1-4 = Low Stock, 5+ = Available) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-exclamation-triangle"></i><h5>Low Stock Alerts</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Product</th><th class="text-end">Qty On Hand</th><th class="text-end">Reorder Level</th><th>Status</th></tr></thead>
                        <tbody>
                        @if (Model.LowStockAlerts != null && Model.LowStockAlerts.Any())
                        {
                            foreach (var a in Model.LowStockAlerts)
                            {
                                <tr>
                                    <td>@a.ProductName</td>
                                    <td class="text-end">@a.QuantityOnHand</td>
                                    <td class="text-end">@a.ReorderLevel</td>
                                    <td><span class="kx-badge @StatusClass(a.StockStatus)">@a.StockStatus</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="kx-empty">No low stock alerts.</td></tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            </div>

            @* Stock Movements (existing data) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-arrow-left-right"></i><h5>Stock Movements</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Date</th><th>Product</th><th>Type</th><th class="text-end">Qty</th><th>Reference</th></tr></thead>
                        <tbody>
                        @if (Model.StockMovements != null && Model.StockMovements.Any())
                        {
                            foreach (var m in Model.StockMovements)
                            {
                                <tr>
                                    <td>@m.Date.ToShortDateString()</td>
                                    <td>@m.ProductName</td>
                                    <td>@m.MovementType</td>
                                    <td class="text-end">@m.Quantity</td>
                                    <td>@m.Reference</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="kx-empty">No records found for the selected filters.</td></tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            </div>

            @* Serial Numbers (existing data) *@
            <div class="kx-section report-section-card mb-3">
                <div class="kx-section-head card-header"><i class="bi bi-upc-scan"></i><h5>Serial Numbers</h5></div>
                <div class="kx-section-body card-body">
                    <div class="kx-table-wrap table-responsive"><table class="table kx-table table-sm table-bordered mb-0">
                        <thead><tr><th>Serial</th><th>Product</th><th>Status</th><th>Sale Id</th><th>Sale Date</th></tr></thead>
                        <tbody>
                        @if (Model.SerialNumberReport != null && Model.SerialNumberReport.Any())
                        {
                            foreach (var s in Model.SerialNumberReport)
                            {
                                <tr>
                                    <td>@s.SerialNumber</td>
                                    <td>@s.ProductName</td>
                                    <td><span class="kx-badge @StatusClass(s.Status)">@s.Status</span></td>
                                    <td>@(s.SaleId?.ToString() ?? "-")</td>
                                    <td>@(s.SaleDate?.ToShortDateString() ?? "-")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="kx-empty">No records found for the selected filters.</td></tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // A. Quick Date Range handler (unchanged behavior)
        document.querySelectorAll('.quick-date-range button').forEach(btn => {
            btn.addEventListener('click', function () {
                const range = this.dataset.range;
                const startInput = document.getElementById('Filter_StartDate');
                const endInput = document.getElementById('Filter_EndDate');
                const today = new Date();
                let startDate = '';
                let endDate = today.toISOString().split('T')[0];
                if (range === '7') {
                    const d = new Date(); d.setDate(today.getDate() - 6);
                    startDate = d.toISOString().split('T')[0];
                } else if (range === '30') {
                    const d = new Date(); d.setDate(today.getDate() - 29);
                    startDate = d.toISOString().split('T')[0];
                }
                if (startDate) {
                    startInput.value = startDate;
                    endInput.value = endDate;
                }
            });
        });
        // B. Landing cards / section switcher (same-page switching, no new routes)
        const landingEl = document.getElementById('reportsLanding');
        const filterAreaEl = document.getElementById('reportsFilterArea');
        const backBtn = document.getElementById('kxBackBtn');
        const activeReportInput = document.getElementById('activeReport');
        function updatePdfButtons(report) {
            const salesBtn = document.getElementById('pdfSalesBtn');
            const inventoryBtn = document.getElementById('pdfInventoryBtn');
            if (salesBtn && inventoryBtn) {
                salesBtn.classList.toggle('kx-hidden', report !== 'Sales');
                inventoryBtn.classList.toggle('kx-hidden', report !== 'Inventory');
            }
        }
        function setActiveReport(report) {
            if (activeReportInput) activeReportInput.value = report;
            updatePdfButtons(report);
        }
        function openSection(targetId) {
            landingEl.classList.add('kx-hidden');
            filterAreaEl.classList.remove('kx-hidden');
            backBtn.classList.remove('kx-hidden');
            document.querySelectorAll('.tab-pane').forEach(pane => { pane.classList.remove('show', 'active'); pane.classList.add('kx-hidden'); });
            const targetPane = document.getElementById(targetId);
            if (targetPane) {
                targetPane.classList.add('show', 'active');
                targetPane.classList.remove('kx-hidden');
            }
            setActiveReport(targetId === 'inventoryTab' ? 'Inventory' : 'Sales');
        }
        document.querySelectorAll('.kx-report-link').forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                openSection(this.dataset.target || this.getAttribute('href').substring(1));
            });
        });
        if (backBtn) {
            backBtn.addEventListener('click', function (e) {
                e.preventDefault();
                landingEl.classList.remove('kx-hidden');
                filterAreaEl.classList.add('kx-hidden');
                backBtn.classList.add('kx-hidden');
                document.querySelectorAll('.tab-pane').forEach(pane => { pane.classList.remove('show', 'active'); pane.classList.add('kx-hidden'); });
                setActiveReport('');
            });
        }
        // Restore the active report after Generate so it does not fall back to the landing page
        (function () {
            const initialActive = '@(activeReport)';
            if (initialActive === 'Sales') {
                openSection('salesTab');
            } else if (initialActive === 'Inventory') {
                openSection('inventoryTab');
            } else if (activeReportInput) {
                activeReportInput.value = '';
            }
        })();
        // C. Inventory Search (unchanged behavior)
        const inventorySearch = document.getElementById('inventorySearch');
        if (inventorySearch) {
            inventorySearch.addEventListener('input', function () {
                const term = this.value.trim().toLowerCase();
                const rows = document.querySelectorAll('#inventoryTab tbody tr');
                let visibleCount = 0;
                rows.forEach(row => {
                    if (row.children.length < 4) return;
                    const product = row.cells[0].textContent.toLowerCase();
                    const category = row.cells[1].textContent.toLowerCase();
                    const match = product.includes(term) || category.includes(term);
                    row.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });
                let noMatchRow = document.getElementById('inventoryNoMatchRow');
                if (!noMatchRow) {
                    noMatchRow = document.createElement('tr');
                    noMatchRow.id = 'inventoryNoMatchRow';
                    const td = document.createElement('td');
                    td.colSpan = 4;
                    td.className = 'text-center';
                    td.textContent = 'No matching products found.';
                    noMatchRow.appendChild(td);
                    document.querySelector('#inventoryTab tbody').appendChild(noMatchRow);
                }
                noMatchRow.style.display = (visibleCount === 0 && term !== '') ? '' : 'none';
            });
        }
        // E. Service Search (new)
        const serviceSearch = document.getElementById('serviceSearch');
        if (serviceSearch) {
            serviceSearch.addEventListener('input', function () {
                const term = this.value.trim().toLowerCase();
                const rows = document.querySelectorAll('#salesTab tbody tr');
                let visibleCount = 0;
                rows.forEach(row => {
                    // Service rows have 8 cells; skip other rows
                    if (row.children.length < 8) return;
                    const serviceName = row.cells[0].textContent.toLowerCase();
                    const serviceId = row.cells[1].textContent.toLowerCase();
                    const jobId = row.cells[2].textContent.toLowerCase();
                    const customer = row.cells[3].textContent.toLowerCase();
                    const match = serviceName.includes(term) || serviceId.includes(term) || jobId.includes(term) || customer.includes(term);
                    row.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });
                // optional no-match handling could be added
            });
        }
        // D. Revenue Trend Chart (existing data, Kaijenson palette)
        const revCtx = document.getElementById('revenueTrendChart').getContext('2d');
        const revenueChart = new Chart(revCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.Period.ToString("yyyy-MM-dd")))),
                datasets: [{
                    label: 'Revenue',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.Revenue))),
                    borderColor: '#FF7F11',
                    backgroundColor: 'rgba(255, 127, 17, 0.12)',
                    fill: true,
                    tension: 0.3,
                    pointBackgroundColor: '#FF7F11'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { display: true, title: { display: true, text: 'Date' } },
                    y: { display: true, title: { display: true, text: 'Amount' } }
                }
            }
        });
        // E. Sales By Category Chart (existing data, Kaijenson semantic colors)
        const catCtx = document.getElementById('salesByCategoryChart').getContext('2d');
        const catChart = new Chart(catCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.SalesByCategory ?? new List<KaijensonIventory_SalesMotorShopWeb.ViewModels.SalesByCategoryViewModel>()).Select(c => c.CategoryName))),
                datasets: [{
                    label: 'Revenue by Category',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.SalesByCategory ?? new List<KaijensonIventory_SalesMotorShopWeb.ViewModels.SalesByCategoryViewModel>()).Select(c => c.Revenue))),
                    backgroundColor: ['#FF7F11', '#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#EF4444']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}
