@model KaijensonIventory_SalesMotorShopWeb.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create New Password";
}

<div class="auth-card">
    <div class="auth-logo">
        <div class="logo-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <h2>Create New Password</h2>
        <p>Choose a new password for your account</p>
    </div>

    <form asp-action="ResetPassword" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <div class="password-wrapper input-icon-group">
                <i class="bi bi-lock input-icon"></i>
                <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" autocomplete="new-password" />
                <button type="button" class="toggle-pwd" aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmNewPassword" class="form-label"></label>
            <div class="password-wrapper input-icon-group">
                <i class="bi bi-lock-fill input-icon"></i>
                <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Confirm new password" autocomplete="new-password" />
                <button type="button" class="toggle-pwd" aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-check2-circle"></i> Reset Password
        </button>
    </form>

    <div class="auth-footer">
        <a asp-action="Login">Back to Login</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}