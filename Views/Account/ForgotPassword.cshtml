@model KaijensonIventory_SalesMotorShopWeb.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="page-header"><div><h1>Forgot Password</h1><p>Enter your username to request a password reset.</p></div></div>
<div class="card form-card"><div class="card-body">
    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3 small"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label for="Username" class="form-label">Username</label>
                <input type="text" name="Username" id="Username" class="form-control" />
                @Html.ValidationMessage("Username", new { @class = "text-danger small" })
            </div>
        </div>
        <div class="form-actions mt-3">
            <button type="submit" class="btn btn-app-primary">
                <i class="bi bi-key" aria-hidden="true"></i>
                <span>Continue</span>
            </button>
            <a asp-action="Login" class="btn btn-app-secondary">Back to Login</a>
        </div>
    </form>
</div></div>
