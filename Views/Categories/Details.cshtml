@model KaijensonIventory_SalesMotorShopWeb.Models.Category
@{ ViewData["Title"] = "Category Details"; }

<div class="page-header">
    <div>
        <h1>Category Details</h1>
        <p>View category information.</p>
    </div>
</div>

<div class="card" style="max-width:600px; margin:0 auto;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CategoryId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CategoryId)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CategoryName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CategoryName)</dd>
        </dl>

        <div class="d-flex gap-2">

            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
        </div>
    </div>
</div>
