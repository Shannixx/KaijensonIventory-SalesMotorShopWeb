@model KaijensonIventory_SalesMotorShopWeb.Models.Category
@{ ViewData["Title"] = "Archive Category"; }

<div class="page-header">
    <div>
        <h1>Archive Category</h1>
        <p>This record will be hidden from active lists and can be restored by an Admin.</p>
    </div>
</div>

<div class="card" style="max-width:600px; margin:0 auto;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CategoryId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CategoryId)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CategoryName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CategoryName)</dd>
        </dl>

        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Archive:</strong> This record remains in the database and can be restored by an Admin.
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CategoryId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-archive"></i> Archive</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to Categories</a>
            </div>
        </form>
    </div>
</div>