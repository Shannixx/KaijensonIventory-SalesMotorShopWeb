@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="page-header">
    <div>
        <h1>Categories</h1>
        <p>Manage product categories.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Category</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name..." value="@ViewData["CurrentFilter"]" style="min-width:200px;" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th>Products</th>
                        <th>Services</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var prodCounts = ViewData["ProductCounts"] as Dictionary<int, int>;
                        var servCounts = ViewData["ServiceCounts"] as Dictionary<int, int>;
                        var prodCount = prodCounts?.GetValueOrDefault(item.CategoryId, 0) ?? 0;
                        var servCount = servCounts?.GetValueOrDefault(item.CategoryId, 0) ?? 0;
                        var isInUse = prodCount > 0 || servCount > 0;
                        <tr>
                            <td>@item.CategoryId</td>
                            <td>@item.CategoryName</td>
                            <td>@prodCount</td>
                            <td>@servCount</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-icon btn-icon-view" title="View category" aria-label="View category @item.CategoryName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-icon btn-icon-edit" title="Edit category" aria-label="Edit category @item.CategoryName"><i class="bi bi-pencil"></i></a>
                                    @if (isInUse)
                                    {
                                        <button type="button" class="btn btn-icon btn-icon-delete disabled" disabled title="This category cannot be deleted until its products and services are reassigned." aria-label="Cannot delete category @item.CategoryName because it is in use"><i class="bi bi-trash"></i></button>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" class="action-form delete-form" data-record-name="@item.CategoryName">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-icon btn-icon-delete" title="Delete category" aria-label="Delete category @item.CategoryName"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No categories found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
