@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="page-header">
    <div>
        <h1>Categories</h1>
        <p>Manage product categories.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Category</a>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Categories",
        QueryValue = ViewData["CurrentFilter"] as string,
        Placeholder = "Search by name...",
        AriaLabel = "Search categories",
        InputId = "searchCategories",
        ClearActionName = "Index",
        ClearControllerName = "Categories"
    };
}
<partial name="_SearchToolbar" model="searchModel" />

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table category-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CategoryId</td>
                            <td>@item.CategoryName</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-icon btn-icon-view" title="View category" aria-label="View category @item.CategoryName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-icon btn-icon-edit" title="Edit category" aria-label="Edit category @item.CategoryName"><i class="bi bi-pencil"></i></a>
                                    @if (ViewBag.CanDelete == true)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" id="delete-category-@item.CategoryId" class="action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-category-@item.CategoryId" data-delete-record-name="@item.CategoryName" data-delete-entity-name="category" title="Delete category" aria-label="Delete category @item.CategoryName"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No categories found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />