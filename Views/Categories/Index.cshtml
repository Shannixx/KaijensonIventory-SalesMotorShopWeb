@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Category>
@{ ViewData["Title"] = "Categories"; }

<div class="page-header">
    <div>
        <h1>Categories</h1>
        <p>Manage product categories.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Category</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name..." value="@ViewData["CurrentFilter"]" style="min-width:200px;" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Category Name</th>
                        <th>Products</th>
                        <th>Services</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var prodCounts = ViewData["ProductCounts"] as Dictionary<int, int>;
                        var servCounts = ViewData["ServiceCounts"] as Dictionary<int, int>;
                        <tr>
                            <td>@item.CategoryId</td>
                            <td>@item.CategoryName</td>
                            <td>@(prodCounts?.GetValueOrDefault(item.CategoryId, 0) ?? 0)</td>
                            <td>@(servCounts?.GetValueOrDefault(item.CategoryId, 0) ?? 0)</td>
                            <td class="action-cell">
                                <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-icon btn-icon-view" title="View Category Details" aria-label="View @item.CategoryName"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-icon btn-icon-edit" title="Edit Category" aria-label="Edit @item.CategoryName"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-icon btn-icon-delete" title="Delete Category" aria-label="Delete @item.CategoryName" onclick="confirmDelete(@item.CategoryId, '@item.CategoryName')"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No categories found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            if (!confirm('Are you sure you want to delete category "' + name + '"?')) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = { 'Content-Type': 'application/x-www-form-urlencoded' };
            if (token) headers['RequestVerificationToken'] = token.value;

            fetch('@Url.Action("Delete", "Categories")/' + id, {
                method: 'POST',
                headers: headers
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(() => alert('An error occurred while deleting the category.'));
        }
    </script>
}
