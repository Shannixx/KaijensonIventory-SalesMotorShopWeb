@model KaijensonIventory_SalesMotorShopWeb.Models.Mechanic
@{ ViewData["Title"] = "Edit Mechanic"; }
<div class="page-header">
    <div>
        <h1>Edit Mechanic</h1>
        <p>Update mechanic details.</p>
    </div>
</div>

<div class="card form-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MechanicId" />
            <div class="mb-3">
                <label class="form-label">Mechanic ID</label>
                <p class="form-control-plaintext">@Model.MechanicId</p>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="MechanicName" class="form-label"></label>
                <input asp-for="MechanicName" class="form-control" />
                <span asp-validation-for="MechanicName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Specialization" class="form-label"></label>
                <input asp-for="Specialization" class="form-control" />
                <span asp-validation-for="Specialization" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContactNumber" class="form-label"></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmailAddress" class="form-label"></label>
                <input asp-for="EmailAddress" class="form-control" type="email" />
                <span asp-validation-for="EmailAddress" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="YearsOfExperience" class="form-label"></label>
                <input asp-for="YearsOfExperience" class="form-control" type="number" min="0" max="60" step="1" />
                <span asp-validation-for="YearsOfExperience" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Work Status</label>
                <p class="form-control-plaintext">@Model.WorkStatus</p>
            </div>

            <div class="mb-3">
                <label class="form-label">Date Hired</label>
                <p class="form-control-plaintext">
                    @(Model.DateHired?.ToString("MMMM dd, yyyy") ?? "Not Provided")
                </p>
            </div>

            <div class="mb-3">
                <label class="form-label">Hired By</label>
                <p class="form-control-plaintext">
                    @(Model.HiredByStaff?.StaffName ?? "System")
                </p>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-app-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    <span>Save Changes</span>
                </button>
                <a asp-action="Index" class="btn btn-app-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
