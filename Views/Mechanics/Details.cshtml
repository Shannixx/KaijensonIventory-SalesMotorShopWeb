@model KaijensonIventory_SalesMotorShopWeb.Models.Mechanic
@{ ViewData["Title"] = "Mechanic Details"; }
<div class="page-header">
    <div>
        <h1>Mechanic Details</h1>
        <p>View mechanic information.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-3">Mechanic Information</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Mechanic ID</dt>
            <dd class="col-sm-9">@Model.MechanicId</dd>

            <dt class="col-sm-3">Mechanic Name</dt>
            <dd class="col-sm-9">@Model.MechanicName</dd>

            <dt class="col-sm-3">Specialization</dt>
            <dd class="col-sm-9">@Model.Specialization</dd>

            <dt class="col-sm-3">Contact Number</dt>
            <dd class="col-sm-9">@Model.ContactNumber</dd>

            <dt class="col-sm-3">Email Address</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.EmailAddress) ? "Not Provided" : Model.EmailAddress)</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">Years of Experience</dt>
            <dd class="col-sm-9">
                @(Model.YearsOfExperience.HasValue ? (Model.YearsOfExperience == 0 ? "Less than 1 year" : Model.YearsOfExperience + " year" + (Model.YearsOfExperience == 1 ? "" : "s")) : "Not Provided")
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
    @if (Model.Status == "Active")
    {
        <span class="badge bg-success">Active</span>
    }
    else
    {
        <span class="badge bg-secondary">Inactive</span>
    }
</dd>

<dt class="col-sm-3">Work Status</dt>
<dd class="col-sm-9">
    @if (Model.WorkStatus == "Available")
    {
        <span class="badge bg-success">Available</span>
    }
    else
    {
        <span class="badge bg-danger">Working</span>
    }
</dd>

            <dt class="col-sm-3">Date Hired</dt>
            <dd class="col-sm-9">@(Model.DateHired?.ToString("MMMM dd, yyyy") ?? "Not Provided")</dd>

            <dt class="col-sm-3">Hired By</dt>
            <dd class="col-sm-9">@(Model.HiredByStaff?.StaffName ?? "System")</dd>
        </dl>
    </div>
</div>
