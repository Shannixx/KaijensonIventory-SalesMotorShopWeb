@model IEnumerable<Mechanic>
@{
    ViewData["Title"] = "Mechanics";
    string? currentFilter = ViewData["CurrentFilter"] as string;
}
<div class="page-header">
    <div>
        <h1>Mechanics</h1>
        <p>Manage mechanics.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Mechanic</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <input type="text" name="searchString" class="form-control" placeholder="Search ID, name, specialization, contact..." value="@currentFilter" style="min-width:250px;" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Specialization</th>
                        <th>Contact</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MechanicId</td>
                            <td>@item.MechanicName</td>
                            <td>@item.Specialization</td>
                            <td>@item.ContactNumber</td>
                            <td class="action-cell">
                                <a asp-action="Details" asp-route-id="@item.MechanicId" class="btn btn-icon btn-icon-view" title="View Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.MechanicId" class="btn btn-icon btn-icon-edit" title="Edit Mechanic"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.MechanicId" class="btn btn-icon btn-icon-delete" title="Delete Mechanic"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No mechanics found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
