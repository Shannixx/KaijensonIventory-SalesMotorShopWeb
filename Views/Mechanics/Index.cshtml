@model IEnumerable<KaijensonIventory_SalesMotorShopWeb.Models.Mechanic>
@{
    ViewData["Title"] = "Mechanics";
    string? currentFilter = ViewData["CurrentFilter"] as string;
    string? statusFilter = ViewData["StatusFilter"] as string ?? "All";
    string? workStatusFilter = ViewData["WorkStatusFilter"] as string ?? "All";
    int page = (int)(ViewData["Page"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
}
<div class="page-header">
    <div>
        <h1>Mechanics</h1>
        <p>Manage mechanics.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">Add Mechanic</a>
        @if (Context.Session.GetString("StaffRole") == "Admin")
        {
            <a asp-action="Index" asp-route-archived="@(ViewBag.ShowArchived == true ? "false" : "true")" class="btn btn-outline-secondary">@(ViewBag.ShowArchived == true ? "Active Mechanics" : "Archived")</a>
        }
    </div>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Mechanics",
        QueryValue = currentFilter,
        Placeholder = "Search ID, name, specialization, contact, email, address...",
        AriaLabel = "Search mechanics",
        InputId = "searchMechanics",
        ClearActionName = "Index",
        ClearControllerName = "Mechanics"
    };
}
<partial name="_SearchToolbar" model="searchModel" />

<form method="get" asp-action="Index" class="row g-2 mb-3 align-items-center">
    <input type="hidden" name="searchString" value="@currentFilter" />
    <div class="col-auto">
        <label class="form-label mb-0">Status</label>
        <select name="statusFilter" class="form-select">
            <option value="All" selected="@(statusFilter == "All" ? "selected" : null)">All</option>
            <option value="Active" selected="@(statusFilter == "Active" ? "selected" : null)">Active</option>
            <option value="Inactive" selected="@(statusFilter == "Inactive" ? "selected" : null)">Inactive</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label mb-0">Work Status</label>
        <select name="workStatusFilter" class="form-select">
            <option value="All" selected="@(workStatusFilter == "All" ? "selected" : null)">All</option>
            <option value="Available" selected="@(workStatusFilter == "Available" ? "selected" : null)">Available</option>
            <option value="Working" selected="@(workStatusFilter == "Working" ? "selected" : null)">Working</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="text-center">ID</th>
                        <th class="text-center">Mechanic Name</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Work Status</th>
                        <th class="text-center actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.MechanicId</td>
                            <td class="text-center">@item.MechanicName</td>
                            <td class="text-center">
    @if (item.Status == "Active")
    {
        <span class="badge bg-success">Active</span>
    }
    else
    {
        <span class="badge bg-secondary">Inactive</span>
    }
</td>
                            <td class="text-center">
    @if (item.Status == "Active")
    {
        if (item.WorkStatus == "Available")
        {
            <span class="badge bg-success">Available</span>
        }
        else
        {
            <span class="badge bg-danger">Working</span>
        }
    }
    else
    {
        <span class="badge bg-secondary">Not Available</span>
    }
</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.MechanicId" asp-route-archived="@(ViewBag.ShowArchived == true ? "true" : "false")" class="btn btn-icon btn-icon-view" title="View Mechanic Details" aria-label="View @item.MechanicName"><i class="bi bi-eye"></i></a>
                                    @if (ViewBag.ShowArchived != true)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MechanicId" class="btn btn-icon btn-icon-edit" title="Edit Mechanic" aria-label="Edit @item.MechanicName"><i class="bi bi-pencil"></i></a>
                                    }

                                    @if (ViewBag.ShowArchived == true)
                                    {
                                        <form asp-action="Restore" asp-route-id="@item.MechanicId" method="post" class="action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-icon" title="Restore mechanic" aria-label="Restore @item.MechanicName"><i class="bi bi-arrow-counterclockwise"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.MechanicId" method="post" id="delete-mechanic-@item.MechanicId" class="action-form">
                                            @Html.AntiForgeryToken()
                                            <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-mechanic-@item.MechanicId" data-delete-record-name="@item.MechanicName" data-delete-entity-name="mechanic" title="Archive mechanic" aria-label="Archive mechanic @item.MechanicName"><i class="bi bi-archive"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No mechanics found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
