@model IEnumerable<Mechanic>
@{
    ViewData["Title"] = "Mechanics";
    string? currentFilter = ViewData["CurrentFilter"] as string;
}
<div class="page-header">
    <div>
        <h1>Mechanics</h1>
        <p>Manage mechanics.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Mechanic</a>
</div>

@{
    var searchModel = new SearchToolbarViewModel
    {
        ControllerName = "Mechanics",
        QueryValue = currentFilter,
        Placeholder = "Search ID, name, specialization, contact...",
        AriaLabel = "Search mechanics",
        InputId = "searchMechanics",
        ClearActionName = "Index",
        ClearControllerName = "Mechanics"
    };
}
<partial name="_SearchToolbar" model="searchModel" />

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Specialization</th>
                        <th>Contact</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MechanicId</td>
                            <td>@item.MechanicName</td>
                            <td>@item.Specialization</td>
                            <td>@item.ContactNumber</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.MechanicId" class="btn btn-icon btn-icon-view" title="View Mechanic Details" aria-label="View @item.MechanicName"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.MechanicId" class="btn btn-icon btn-icon-edit" title="Edit Mechanic" aria-label="Edit @item.MechanicName"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.MechanicId" method="post" id="delete-mechanic-@item.MechanicId" class="action-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-icon btn-icon-delete" data-delete-trigger data-delete-form-id="delete-mechanic-@item.MechanicId" data-delete-record-name="@item.MechanicName" data-delete-entity-name="mechanic" title="Delete mechanic" aria-label="Delete mechanic @item.MechanicName"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No mechanics found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
