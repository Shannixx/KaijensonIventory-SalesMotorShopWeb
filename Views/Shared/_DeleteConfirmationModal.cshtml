<div class="modal fade"
     id="deleteConfirmationModal"
     tabindex="-1"
     aria-labelledby="deleteConfirmationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmationModalLabel">Confirm archive</h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="mb-2">
                    Are you sure you want to archive
                    <strong id="deleteConfirmationRecordName"></strong>?
                </p>

                <p class="text-muted mb-0">The record will be hidden from active lists and can be restored by an Admin.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

                <button type="button" class="btn btn-danger" id="confirmDeleteButton">Archive</button>
            </div>

        </div>
    </div>
</div>
