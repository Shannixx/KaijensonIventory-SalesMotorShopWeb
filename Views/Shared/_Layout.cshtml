@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(string c, string a = "") =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(a) || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));
    string? ActiveAttr(string c, string a = "") => IsActive(c, a) ? "page" : null;

    string? staffName = Context.Session.GetString("StaffName");
    string? staffRole = Context.Session.GetString("StaffRole");
    string avatarChar = !string.IsNullOrEmpty(staffName) ? staffName[..1].ToUpper() : "K";
    bool isAdmin = string.Equals(staffRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(staffRole, "Owner", StringComparison.OrdinalIgnoreCase);
    bool isOwnerOrManager = isAdmin ||
                   string.Equals(staffRole, "Manager", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kaijenson Motor Shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KaijensonIventory_SalesMotorShopWeb.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
    <a href="#main-content" class="visually-hidden-focusable" style="position:absolute;z-index:9999;padding:0.5rem 1rem;background:var(--primary);color:#fff;text-decoration:none;">Skip to main content</a>
    <aside class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
        <div class="sidebar-header">
            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                <i class="bi bi-wrench"></i>
                <span class="brand-text">Kaijenson<br /><small>Motor Shop</small></span>
            </a>
            <button class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Close navigation menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="sidebar-body">
            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="nav-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link @(IsActive("Dashboard") ? "active" : "")" data-title="Dashboard" aria-current="@ActiveAttr("Dashboard")">
                            <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                        </a>
                    </li>
                </ul>

                <div class="nav-section">Management</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a asp-controller="Categories" asp-action="Index" class="nav-link @(IsActive("Categories") ? "active" : "")" data-title="Category" aria-current="@ActiveAttr("Categories")">
                            <i class="bi bi-tags"></i><span>Category</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Brands" asp-action="Index" class="nav-link @(IsActive("Brands") ? "active" : "")" data-title="Brand" aria-current="@ActiveAttr("Brands")">
                            <i class="bi bi-award"></i><span>Brand</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Mechanics" asp-action="Index" class="nav-link @(IsActive("Mechanics") ? "active" : "")" data-title="Mechanic" aria-current="@ActiveAttr("Mechanics")">
                            <i class="bi bi-tools"></i><span>Mechanic</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Suppliers" asp-action="Index" class="nav-link @(IsActive("Suppliers") ? "active" : "")" data-title="Supplier" aria-current="@ActiveAttr("Suppliers")">
                            <i class="bi bi-truck"></i><span>Supplier</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Products" asp-action="Index" class="nav-link @(IsActive("Products") ? "active" : "")" data-title="Product" aria-current="@ActiveAttr("Products")">
                            <i class="bi bi-box-seam-fill"></i><span>Product</span>
                        </a>
                    </li>
                    @if (isOwnerOrManager)
                    {
                        <li class="nav-item">
                            <a asp-controller="PurchaseOrders" asp-action="Index" class="nav-link @(IsActive("PurchaseOrders") ? "active" : "")" data-title="Purchase Order" aria-current="@ActiveAttr("PurchaseOrders")">
                                <i class="bi bi-cart-check"></i><span>Purchase Order</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Delivery" asp-action="Index" class="nav-link @(IsActive("Delivery") ? "active" : "")" data-title="Delivery" aria-current="@ActiveAttr("Delivery")">
                                <i class="bi bi-truck"></i><span>Delivery</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a asp-controller="Services" asp-action="Index" class="nav-link @(IsActive("Services") ? "active" : "")" data-title="Service" aria-current="@ActiveAttr("Services")">
                            <i class="bi bi-gear"></i><span>Service</span>
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a asp-controller="Staff" asp-action="Index" class="nav-link @(IsActive("Staff") ? "active" : "")" data-title="Staff" aria-current="@ActiveAttr("Staff")">
                                <i class="bi bi-people-fill"></i><span>Staff</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="nav-section">System</div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a asp-controller="ActivityLog" asp-action="Index" class="nav-link @(IsActive("ActivityLog") ? "active" : "")" data-title="Activity Log" aria-current="@ActiveAttr("ActivityLog")">
                            <i class="bi bi-clock-history"></i><span>Activity Log</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="sidebar-footer">
            <a asp-controller="Account" asp-action="Logout" class="nav-link logout-link" data-title="Log Out"><i class="bi bi-box-arrow-right"></i><span>Log Out</span></a>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main-wrapper">
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sidebar" id="sidebarToggle" title="Toggle Sidebar" aria-label="Toggle navigation menu" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn dropdown-toggle d-flex align-items-center gap-2 bg-transparent border-0" data-bs-toggle="dropdown" aria-label="User menu">
                        <div class="avatar-sm" style="background: rgba(253,126,20,0.15); color: var(--primary); font-weight: 600;">@avatarChar</div>
                        <div class="d-none d-md-block text-start">
                            <div class="small fw-medium" style="line-height:1.2">@(staffName ?? "User")</div>
                            <div class="small" style="font-size:11px; color: var(--text-muted);">@(staffRole ?? "")</div>
                        </div>
                        <i class="bi bi-chevron-down" style="font-size:12px; color: var(--text-muted);"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width:200px;">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="main-content" id="main-content">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <partial name="_DeleteConfirmationModal" />

    <div class="modal fade" id="printPreviewModal" tabindex="-1" aria-labelledby="printPreviewModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="printPreviewModalLabel">Print Preview - <span id="printPreviewPONumber"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="printPreviewBody">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 text-muted">Loading print preview...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> Close</button>
                    <button type="button" class="btn btn-primary" id="printPreviewBtn"><i class="bi bi-printer"></i> Print</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
