@model IEnumerable<ActivityLog>
@{ ViewData["Title"] = "Activity Log"; }

<div class="page-header">
    <div>
        <h1>Activity Log</h1>
        <p>System audit trail.</p>
    </div>
</div>

<div class="search-toolbar-card">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label class="form-label small">Search</label>
            <input type="text" name="searchString" class="form-control search-toolbar-input" placeholder="Description or action..." value="@ViewData["CurrentFilter"]" />
        </div>
        <div>
            <label class="form-label small">Module</label>
            <select name="module" class="form-select" asp-items="ViewBag.Modules">
                <option value="">All Modules</option>
            </select>
        </div>
        <div>
            <label class="form-label small">Date From</label>
            <input type="date" name="dateFrom" class="form-control" value="@ViewData["DateFrom"]" />
        </div>
        <div>
            <label class="form-label small">Date To</label>
            <input type="date" name="dateTo" class="form-control" value="@ViewData["DateTo"]" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn-search"><i class="bi bi-search"></i> Search</button>
            <a asp-action="Index" class="btn-clear"><i class="bi bi-x-lg"></i> Clear</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr><th>Timestamp</th><th>Module</th><th>Action</th><th>Staff</th><th>Description</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Timestamp.ToString("MMM dd, yyyy HH:mm")</td>
                            <td><span class="badge bg-info">@item.Module</span></td>
                            <td>@item.Action</td>
                            <td>@item.Staff?.StaffName</td>
                            <td>@item.Description</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">No logs found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<partial name="_Pagination" />
